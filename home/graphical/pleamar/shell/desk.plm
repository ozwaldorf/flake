// The desk: a rail on the left edge of each monitor that widens on hover and
// opens into a drawer of pages (control centre, system, apps, clipboard,
// keys), a task bar along the bottom, toasts beside the rail and a veil over
// everything. The rail sits behind the windows: opening it reserves room, and
// the window manager slides the strip aside to uncover it.
//
// Talked to from outside with `pleamar-wm --say desk "emit ..."`; see the IPC
// section below. Pages are parts (pages/*.plm), each with its logic module
// (logic/*.luau, required from desk.luau).
language 0.4
import "../gen/theme.plm"

scene Desk {
    permissions {
        run: "pleamar-wm", "sh", "libinput", "cat", "awk", "nvidia-smi", "top", "cliphist", "wl-copy", "fortune", "systemctl", "busctl", "slurp", "gpu-screen-recorder", "kill", "rio", "setsid", "nix-locate", "nix", "stat", "uname", "hostname", "id", "readlink", "nixos-version", "lsblk", "findmnt", "curl", "mkdir", "date", "nproc", "zsh", "env"
        services: "clock", "clock.seconds", "audio", "audio.*", "battery", "brightness", "brightness.*", "network", "network.*", "bluetooth", "bluetooth.*", "media", "media.*", "window", "window.*", "apps", "apps.*", "tray", "tray.*", "notifications", "notifications.*", "notification_history", "notification_history.*", "session.*", "files", "files.write", "env", "clipboard", "clipboard.set"
    }

    // geometry (Theme.qml's)
    let sliver = 6
    let rail = 44
    let pagew = 400
    let inset = 16
    let drawerw = pagew + 2 * inset
    let tabsh = 44
    let taskbar = 44
    // A page's room: from its top-left corner (pg.x, pg.y), pagew wide.
    let pg.x = rail + inset
    let pg.y = inset
    spring niri = 800, 57
    spring quint = 260, 32

    // The frosting behind the shell's glass: the window manager's own
    // (wm/blur.wgsl, dual kawase), so the two match.
    blur = file "../wm/blur.wgsl" {
        passes: down 0.5 repeat 5, up 2 repeat 4, grade 1
        values: 3, 0.02, 1, 1
        reach: 64
    }

    // icons: Nerd Font glyphs, set by the logic (logic/icons.luau)
    text ic.close = ""
    text ic.cpu = ""
    text ic.memory = ""
    text ic.network = ""
    text ic.disk = ""
    text ic.gpu = ""
    text ic.host = ""
    text ic.search = ""
    text ic.calc = ""
    text ic.terminal = ""
    text ic.clipboard = ""
    text ic.keyboard = ""
    text ic.image = ""
    text ic.text = ""
    text ic.app = ""
    text ic.trash = ""
    text ic.run = ""
    text ic.gear = ""
    text ic.battery = ""

    // what the window manager reports
    fact ws.shown.0 = 1
    fact ws.shown.1 = 1
    fact ws.shown.2 = 1
    fact ws.shown.3 = 1
    fact ws.pools.0 = 1
    fact ws.pools.1 = 1
    fact ws.pools.2 = 1
    fact ws.pools.3 = 1
    fact ws.occ.0 = 0
    fact ws.occ.1 = 0
    fact ws.occ.2 = 0
    fact ws.occ.3 = 0
    // the rail's highlight of the shown workspace, per monitor and workspace:
    // a spring inside the rail would be one value shared by every monitor
    repeat s in 0..4 {
        repeat k in 1..11 {
            prop wf.$s.$k = 0 ~260ms
            follow wf.$s.$k = if(pick(s, ws.shown.0, ws.shown.1, ws.shown.2, ws.shown.3) == k, 1, 0)
        }
    }
    fact focmon = 0
    // the monitor the pointer is on, and whether a window is being dragged,
    // as the window manager says: the cursor position alone does not tell
    // the monitors apart
    fact ptrmon = 0
    fact dragging = false
    // each monitor's size, as the window manager says (size_report)
    fact mw.0 = 1920
    fact mw.1 = 1920
    fact mw.2 = 1920
    fact mw.3 = 1920
    fact mh.0 = 1080
    fact mh.1 = 1080
    fact mh.2 = 1080
    fact mh.3 = 1080
    // each monitor's overview, as the window manager says (ov_report)
    fact ovm.0 = false
    fact ovm.1 = false
    fact ovm.2 = false
    fact ovm.3 = false
    event ws_go ->
    event wm_overview ->

    // notifications: kept until dismissed, so the list is the history
    model notes max 50 { id: number; app: text; title: text; body: text; icon: image 32, 32; image: image 64, 64; urgency: number; time: number }
    service notifications { list: notes }
    // The scene is the service's one receiver, so a watch in the logic hears
    // nothing: it is told of a change through this, and reads the list.
    event notes_changed ->
    on change notes.0.id { emit notes_changed }
    on change notes.count { emit notes_changed }
    let notes.critical = notes.total > 0 and (notes.0.urgency > 1.5 or notes.1.urgency > 1.5 or notes.2.urgency > 1.5 or notes.3.urgency > 1.5 or notes.4.urgency > 1.5)

    // load meters, sampled by the logic (logic/meters.luau): 0 to 1
    fact m.cpu = 0
    fact m.mem = 0
    fact m.gpu = -1
    fact m.disk = 0
    fact m.down = 0
    fact m.up = 0
    fact meters.fast = false

    // the drawer: one page open at a time, on one monitor
    // 0 closed, 1 settings, 2 info, 3 apps, 4 clipboard, 5 keys.
    fact page = 0
    fact lastpage = 1
    fact dmon = 0
    // Pages that type, or were opened from the keyboard, stay open when the
    // pointer leaves.
    fact held = false
    let open = page > 0.5
    let pidx = pick(max(page, 1) - 1, 0, 1, 2, 3, 4)
    prop pager = 0 ~niri
    follow pager = pidx
    prop dw = 0 ~niri
    follow dw = if(open, drawerw, 0)
    on change page while page > 0.5 { lastpage = page }
    // From closed it opens straight on the page; between pages it slides.
    on change page while page > 0.5 and dw < 1 { pager: pidx ~0ms }

    // the rail of each monitor: a sliver, 44 wide on hover
    fact hov.0 = false
    fact hov.1 = false
    fact hov.2 = false
    fact hov.3 = false
    prop rv.0 = 0 ~niri
    prop rv.1 = 0 ~niri
    prop rv.2 = 0 ~niri
    prop rv.3 = 0 ~niri
    follow rv.0 = if(hov.0 or (open and dmon == 0), 1, 0)
    follow rv.1 = if(hov.1 or (open and dmon == 1), 1, 0)
    follow rv.2 = if(hov.2 or (open and dmon == 2), 1, 0)
    follow rv.3 = if(hov.3 or (open and dmon == 3), 1, 0)

    // the veil: a blur over everything that takes all input
    fact veil = false
    prop veilp = 0 ~200ms
    follow veilp = if(veil, 1, 0)

    // IPC: `pleamar-wm --say desk "emit drawer_toggle 3"` and so on. Pages are
    // 1 settings, 2 info, 3 apps, 4 clipboard, 5 keys; lists are 1 wifi,
    // 2 bluetooth, 3 speaker, 4 mic, 5 power.
    event drawer_toggle
    event drawer_open
    event drawer_close
    event drawer_overview
    event drawer_list
    event drawer_next
    event drawer_prev
    event veil_raise
    event veil_lower
    event veil_toggle
    // The control centre list asked for: 0 none, 1 wifi, 2 bluetooth, 3 speaker, 4 mic, 5 power.
    fact list = 0
    on drawer_toggle(v) while page == v {
        page = 0
        held = false
    }
    on drawer_toggle(v) while page != v {
        page = v
        dmon = focmon
        held = v > 2.5
    }
    on drawer_open(v) {
        page = v
        dmon = focmon
        held = v > 2.5
    }
    on drawer_close {
        page = 0
        held = false
    }
    // the overview of the monitor with the keyboard, toggled with its drawer
    let kov = pick(focmon, ovm.0, ovm.1, ovm.2, ovm.3)
    on drawer_overview while kov {
        page = 0
        held = false
        emit wm_overview(focmon)
    }
    on drawer_overview while not kov {
        page = 1
        dmon = focmon
        held = true
    }
    on drawer_list(v) {
        page = 1
        dmon = focmon
        held = true
        list = v
    }
    on drawer_next while open { page = mod(page, 5) + 1 }
    on drawer_prev while open { page = mod(page + 3, 5) + 1 }
    on veil_raise { veil = true }
    on veil_lower { veil = false }
    on veil_toggle { toggle veil }
    on key Escape while open {
        page = 0
        held = false
    }
    on key Ctrl+Tab while open {
        page = mod(page, 5) + 1
        held = true
    }
    on key Ctrl+Shift+Tab while open {
        page = mod(page + 3, 5) + 1
        held = true
    }
    on change page while page < 0.5 { list = 0 }

    // The control centre goes with the window manager's overview on the same
    // monitor, both ways.
    let dov = pick(dmon, ovm.0, ovm.1, ovm.2, ovm.3)
    on change page while page == 1 and not dov { emit wm_overview(dmon + 4) }
    on change page while page != 1 and dov { emit wm_overview(dmon) }
    repeat s in 0..4 {
        on change ovm.$s while ovm.$s and page < 0.5 {
            page = 1
            dmon = s
            held = true
        }
        on change ovm.$s while not ovm.$s and page == 1 and dmon == s {
            page = 0
            held = false
        }
    }

    // what the pages keep at the scene level: models, services, texts and
    // facts the logic talks to (declared inside the per-monitor rail they
    // would be one per copy, out of the logic's reach)
    include "pages/settings-data.plm"
    include "pages/search.plm"
    include "pages/cards.plm"
    include "pages/info-decl.plm"
    include "../gen/info-series.plm"

    // the rail surface: the rail, the drawer behind it and its pages. First,
    // since a focused field borrows the first surface's keyboard mode
    surface railbar {
        include "pages/screen.plm"
        // the whole monitor, so the rail can sit on either edge: what is not a
        // zone lets the pointer through
        size: full, full
        anchor: left
        screens: each
        level: top, overlay while open
        // pleamar keeps one keyboard condition per scene, the last one written,
        // so the veil's is here too
        keyboard: on_demand while open or veil

        // The drawer stays while the pointer is anywhere over it; this goes
        // first so the rail's own zones take the presses.
        // the rail and drawer, where they start on this side
        group {
            move: rox, 0
            zone box keep { from: 0, 0; size: push, Hs }
            on still inrail for 400ms while not inrail and open and here and not held { page = 0 }
            on enter keep while not dragging { hov.$screen = true }
            // Hover is read from where the mouse is, not from the zone's enter and away:
            // the compositor reports a leave while the rail slides out under a
            // mouse held at the edge, and a fast move to the edge brings no enter.
            // the cursor across the rail and drawer, from where they start
            let lx = railbar.cursor.x - rox
            let inrail = ptrmon == me and not dragging and lx >= 0 and lx < push + 2 and railbar.cursor.y >= 0 and railbar.cursor.y < Hs
            on still inrail for 400ms while not inrail and pick(me, hov.0, hov.1, hov.2, hov.3) { hov.$screen = false }
            on change inrail while inrail { hov.$screen = true }

            // the backdrop: mantle under the drawer, base under the rail, with
            // shadows cut into the edge so it reads as a recess
            box { from: 0, 0; size: push, Hs; color: mantle }
            box { from: rx, 0; size: railw, Hs; color: base }
            // (the drawer's outer edge is at push on the left side, at 0 on the
            // right; the rail's inner edge at railw, or at rx)
            let rcx = if(right, 0, push)
            let rcd = if(right, 18, -18)
            group {
                mask: rcx, 0 to rcx + rcd, 0
                opacity: recess
                box { from: min(rcx, rcx + rcd), 0; size: 18, Hs; color: crust }
            }
            let rix = if(right, rx, railw)
            group {
                mask: rix, 0 to rix - rcd, 0
                opacity: recess * clamp((push - railw) / 40, 0, 1)
                box { from: min(rix, rix - rcd), 0; size: 18, Hs; color: crust }
            }
            // A pixel in the rail's top corner opens the control centre, as a hot
            // corner.
            let incorner = ptrmon == me and not dragging and if(right, lx >= push - 2 and lx < push + 1, lx >= 0 and lx < 2) and railbar.cursor.y >= 0 and railbar.cursor.y < 2
            on change incorner while incorner {
                page = 1
                dmon = me
                held = true
            }

            // the rail's head: clock, notices, workspaces
            let cx = rx + railw / 2
            // Collapsed, a skeleton of marks stands in for what is there.
            box { at: cx, 30; size: 6, 22; color: surface1; opacity: 1 - reveal }
            text "{floor(now.hour / 10)}{mod(now.hour, 10)}" { at: cx, 22; anchor: center; size: 14; color: text; family: "Berkeley Mono"; opacity: reveal }
            text "{floor(now.minute / 10)}{mod(now.minute, 10)}" { at: cx, 40; anchor: center; size: 14; color: overlay2; family: "Berkeley Mono"; opacity: reveal }
            // The gear: how many notices, red with a critical one among them.
            // A square block, as tall as an icon, widening with the rail and for
            // a count of two or three digits (about 6 wide each at this size).
            let gearn = if(notes.total >= 100, 3, if(notes.total >= 10, 2, 1))
            let gearw = sliver + (max(18, gearn * 6 + 10) - sliver) * reveal
            box { at: cx, 68; size: gearw, 18; color: mix(if(notes.critical, red, if(notes.total > 0, yellow, surface1)), text, 0.25 * max(gearz.hover, page == 1)) }
            text "{notes.total}" { at: cx, 68; anchor: center; size: 10; weight: 700; color: crust; family: "Berkeley Mono"; opacity: reveal * (notes.total > 0) }
            zone box gearz { at: cx, 68; size: 44, 22; cursor: pointer; label: "Control centre" }
            on press gearz {
                page = 1
                dmon = me
                held = false
            }
            // The top corner, held a moment, opens the control centre too.
            zone box headz { from: rx, 0; size: railw, 80 }
            on hover headz for 50ms while not open {
                page = 1
                dmon = me
                held = false
            }

            // where the rail's foot (its load meters) starts
            let meter.y = Hs - inset - 30
            // A press on the rail elsewhere closes the drawer. Declared before the
            // workspace marks, so they are on top and take their own presses.
            zone box railz { from: rx, 80; size: railw, max(meter.y - 4 * 42 - 6 - 80, 0) }
            on press railz while open { page = 0 }
            let ws.shown = pick(me, ws.shown.0, ws.shown.1, ws.shown.2, ws.shown.3)
            let ws.pools = pick(me, ws.pools.0, ws.pools.1, ws.pools.2, ws.pools.3)
            let ws.occ = pick(me, ws.occ.0, ws.occ.1, ws.occ.2, ws.occ.3)
            column {
                at: cx, 98
                anchor: center top
                gap: 12
                repeat k in 1..11 {
                    group {
                        // up to the one shown, and one empty past the last that
                        // holds windows, as niri keeps
                        show: k <= ws.shown or floor(ws.occ / pow(2, k - 2)) > 0
                        let busy = mod(floor(ws.occ / pow(2, k - 1)), 2) > 0.5
                        let wf = pick(me, wf.0.$k, wf.1.$k, wf.2.$k, wf.3.$k)
                        // as big as the mark itself, so the column closes up and the
                        // shown one pushes the others as it grows
                        let wmw = 6 + 6 * reveal
                        let wmh = 12 + 18 * wf
                        size: 6 + 6 * reveal, 12 + 18 * pick(me, wf.0.$k, wf.1.$k, wf.2.$k, wf.3.$k)
                        box { at: wmw / 2, wmh / 2; size: wmw, wmh; color: mix(if(busy, overlay1, if(reveal > 0.5, surface2, surface1)), blue, wf) }
                        zone box wsz.$k { at: wmw / 2, wmh / 2; size: 20, wmh + 12; cursor: pointer; label: "Workspace {k}" }
                        on press wsz.$k { emit ws_go(me + 4 * k) }
                    }
                }
            }

            // the rail's foot: load meters, network cpu gpu memory disk
            repeat k in 0..5 {
                let lvl = pick(k, m.down + m.up, m.cpu, m.gpu, m.mem, m.disk)
                let my = meter.y - (4 - k) * 42 + 42 * (m.gpu < 0 and k < 2)
                group {
                    show: k != 2 or m.gpu >= 0
                    prop lv.$k = 0 ~400ms
                    follow lv.$k = clamp(lvl, 0, 1)
                    box { at: cx, my + 15; size: 6 + 10 * reveal, 30; color: mantle; opacity: 0.8 }
                    box { from: cx - (3 + 5 * reveal), my + 30 - 30 * lv.$k; size: 6 + 10 * reveal, 30 * lv.$k; color: pick(k, sky, mauve, blue, green, yellow) }
                    // Network: what goes up stacked over what comes down.
                    box { from: cx - (3 + 5 * reveal), my + 30 - 30 * lv.$k; size: 6 + 10 * reveal, 30 * clamp(m.up, 0, 1); color: peach; opacity: k == 0 }
                }
            }
            zone box footz { from: rx, meter.y - 4 * 42 - 6; size: railw, Hs - (meter.y - 4 * 42 - 6) }
            on hover footz for 50ms while not open {
                page = 2
                dmon = me
                held = false
            }
            on enter footz { meters.fast = true }
            on leave footz { meters.fast = false }


            // the pages, side by side, uncovered as the drawer opens
            group {
                show: here and dw > 1
                clip box { from: if(right, 0, rail), 0; size: max(push - rail, 0), Hs }
                // The pages are laid out from pg.x, beside a rail on their left;
                // on the right side there is none, so they shift back over it.
                group {
                move: if(right, -rail, 0), 0
                    group {
                        show: abs(0 - pager) < 0.999
                        move: (0 - pager) * drawerw, 0
                        include "pages/settings.plm"
                    }
                    group {
                        show: abs(1 - pager) < 0.999
                        move: (1 - pager) * drawerw, 0
                        include "pages/info.plm"
                    }
                    group {
                        show: abs(2 - pager) < 0.999
                        move: (2 - pager) * drawerw, 0
                        include "pages/apps.plm"
                    }
                    group {
                        show: abs(3 - pager) < 0.999
                        move: (3 - pager) * drawerw, 0
                        include "pages/clipboard.plm"
                    }
                    group {
                        show: abs(4 - pager) < 0.999
                        move: (4 - pager) * drawerw, 0
                        include "pages/keys.plm"
                    }

                    // the tabs along the drawer's foot
                    let tabs.y = Hs - inset - tabsh
                    let tabw = pagew / 5
                    Well(pg.x, tabs.y, pagew, tabsh)
                    prop tabpill = 0 ~quint
                    follow tabpill = pidx
                    box { from: pg.x + tabpill * tabw + 4, tabs.y + 4; size: tabw - 8, tabsh - 8; corner: 6; color: surface0 }
                    repeat k in 0..5 {
                        let tx = pg.x + k * tabw + tabw / 2
                        let on = pidx == k and open
                        text pick(k, ic.gear, ic.cpu, ic.app, ic.clipboard, ic.keyboard) {
                            at: tx, tabs.y + 16; anchor: center; size: 13; family: "FiraCode Nerd Font"
                            color: if(on, text, mix(overlay0, subtext0, tab.$k.hover))
                        }
                        text pick(k, "Control", "System", "Apps", "Clipboard", "Keys") {
                            at: tx, tabs.y + 32; anchor: center; size: 9; family: "Berkeley Mono"
                            color: if(on, text, mix(overlay0, subtext0, tab.$k.hover))
                        }
                        zone box tab.$k { from: pg.x + k * tabw, tabs.y; size: tabw, tabsh; cursor: pointer }
                        on press tab.$k {
                            page = k + 1
                            held = k > 1.5
                        }
                    }
                }
            }
        }
    }

    // The room the window manager leaves on each monitor: the rail's while
    // it shows, and the drawer's beside it while it is open. On the left of
    // the first monitor and (negative) the right of the others, where the
    // rail is. Told to the window manager rather than reserved by surfaces,
    // whose reserve cannot differ per monitor.
    event room_report ->
    repeat s in 0..4 {
        let room.$s = (44 * if(pick(s, hov.0, hov.1, hov.2, hov.3) or (open and dmon == s), 1, 0) + 432 * if(open and dmon == s, 1, 0)) * if(s > 0.5, -1, 1)
        on change room.$s { emit room_report(s + 4 * (room.$s + 4096)) }
    }

    // the veil: a blur over every monitor that swallows all input, raised
    // before the screens dim and by Super+V
    surface veilsurf {
        // its own names: a let shared with the rail's copies is one value
        let vs.W = pick(screen.index, mw.0, mw.1, mw.2, mw.3)
        let vs.H = pick(screen.index, mh.0, mh.1, mh.2, mh.3)
        size: full, full
        anchor: top_left
        level: overlay
        screens: each
        open: veilp > 0.001
        body {
            color: crust
            glass: 100%
            refraction: 0
            dispersion: 0
            ripple: 0
            frost: 100%
            opacity: veilp
            box { from: 0, 0; size: vs.W, vs.H }
        }
        zone box veilz { from: 0, 0; size: vs.W, vs.H }
        on press veilz { veil = true }
    }

    // the task bar, toasts, the recorder and the input overlay: parts of their own
    include "pages/taskbar.plm"
    include "pages/toasts.plm"
    include "pages/keyshow.plm"

    // what the drawer needs from the clock
    service clock as now { time: text = "--:--"; hour: number; minute: number; date: text; weekday: number; day: number; month: number; year: number }
}
