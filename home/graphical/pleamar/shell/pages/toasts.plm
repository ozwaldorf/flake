// Toasts: notices beside the rail on the monitor with the keyboard, each for
// its own while (ten seconds unless the app says, never when critical), and
// the song that just started above them. Held back while the control centre
// is open, which lists them all.
part Toasts {
    // Filled by logic/toasts.luau from the notifications as they arrive.
    model ts.cards max 6 { app: text; title: text; body: text; hasbody: bool; urgency: number; gone: bool }
    event ts_dismiss ->

    // The song: shown on a track change for ten seconds, longer while hovered.
    service media as ts.mp { playing: bool; title: text; artist: text; player: text; art: text }
    image ts.art = from ts.mp.art, 56, 56
    fact ts.song = false
    fact ts.songhover = false
    prop ts.songp = 0 ~200ms
    follow ts.songp = if(ts.song and page != 1, 1, 0)

    let ts.w = 340

    // A new notice: the ones below start where they were and slide down by
    // its height on the window layout's spring, and it fades in once they are
    // three quarters of the way (95ms), as a new window does. ts.pending is
    // set by the logic with the new row, so the list's growth is read as it.
    fact ts.pending = false
    fact ts.h0 = 0
    fact ts.dh = 0
    fact ts.armed = false
    prop ts.dy = 0 ~niri
    prop ts.in = 1 ~250ms
    on still ts.pending for 200ms while ts.pending { ts.pending = false }

    surface toasts {
        // its own names for what the rail works out (see pages/screen.plm)
        let ts.me = screen.index
        let ts.W = mw[ts.me]
        let ts.railw = sliver + (rail - sliver) * rv[ts.me]
        // beside the rail, whichever side it is on
        let ts.x = if(ts.me > 0, ts.W - ts.railw - 8 - ts.w, ts.railw + 8)
        // the whole monitor, so the toasts can sit on either side
        size: full, full
        anchor: left
        screens: each
        level: overlay

        // (here, where the list is measured: the monitor that shows it; the
        // growth goes through ts.dh, since a transition reads its facts after
        // the rule has set them). The new one's words are measured over a few
        // frames: the rest stay where they were until it has its height, then
        // slide.
        on change ts.list.height while ts.pending and ts.me == focmon {
            ts.dh = ts.list.height - ts.h0
            ts.h0 = ts.list.height
            ts.dy: ts.dh ~0ms
            ts.in: 0 ~0ms
            ts.pending = false
            ts.armed = true
        }
        on change ts.list.height while ts.armed and not ts.pending and ts.me == focmon {
            ts.dh = ts.list.height - ts.h0
            ts.h0 = ts.list.height
            ts.dy: ts.dy + ts.dh ~0ms
        }
        on still ts.list.height for 20ms while ts.armed and ts.me == focmon {
            ts.dy: 0
            ts.in: 1 after 95ms
            ts.armed = false
        }
        on change ts.list.height while not ts.armed and not ts.pending and ts.me == focmon { ts.h0 = ts.list.height }

        column {
            at: ts.x, 12
            gap: 14
            show: ts.me == focmon and page != 1

            // the song
            group {
                show: ts.songp > 0.01
                size: ts.w, 76
                opacity: ts.songp
                move: -14 * (1 - ts.songp), 0
                body {
                    color: base
                    glass: 80%
                    lens: false
                    shadow: 0, 6, 24, 35%, crust
                    box { from: 0, 0; size: ts.w, 76; corner: 10 }
                }
                box { from: 0, 0; size: ts.w, 76; corner: 10; color: base; opacity: 0.8 }
                box { from: 0.5, 0.5; size: ts.w - 1, 75; corner: 10; stroke: 1; color: if(ts.songz.hover > 0.5, surface2, surface1) }
                box { from: 10, 10; size: 56, 56; corner: 28; color: surface0 }
                group {
                    clip ellipse { at: 38, 38; radius: 28 }
                    image ts.art { at: 10, 10; size: 56, 56 }
                }
                text ts.mp.title { at: 80, 26; anchor: left center; size: 11; color: text; family: "Berkeley Mono"; width: ts.w - 94; lines: 1 }
                text ts.mp.artist { at: 80, 46; anchor: left center; size: 10; color: overlay2; family: "Berkeley Mono"; width: ts.w - 94; lines: 1 }
                zone box ts.songz { from: 0, 0; size: ts.w, 76; corner: 10; cursor: pointer; label: "Now playing" }
                on enter ts.songz { ts.songhover = true }
                on leave ts.songz { ts.songhover = false }
                on press ts.songz { ts.song = false }
            }

            // the notices
            column ts.list {
                gap: 14
                for n in ts.cards { ToastCard(n) }
            }
        }
    }

    // A notice, as tall as what it says.
    component ToastCard(n: record) {
        size: ts.w, words.height + 28
        // A copy is a place in the list, not a notice: a new one comes in at
        // the top and the rest shift down a copy, so only the top one fades
        // in (ts.in), and one that appears at the bottom is already shown.
        prop shown = 1 ~200ms
        follow shown = if(n.gone, 0, 1)
        let top = n.index == 0
        group {
            // (never quite 0: a column leaves no gap for what is not seen)
            opacity: max(shown * if(top, ts.in, 1), 0.01)
            move: -14 * (1 - ts.in) * top, -ts.dy * (not top)
            // A window's glass with a terminal's background over it (rio:
            // base at 80%); the frosting is the session's material default.
            body {
                color: base
                glass: 80%
                lens: false
                shadow: 0, 6, 24, 35%, crust
                box { from: 0, 0; size: ts.w, words.height + 28; corner: 10 }
            }
            box { from: 0, 0; size: ts.w, words.height + 28; corner: 10; color: base; opacity: 0.8 }
            box { from: 0.5, 0.5; size: ts.w - 1, words.height + 27; corner: 10; stroke: 1; color: if(ts.hit.hover > 0.5, surface2, surface1) }
            // The accent bar on the rail's side: red critical, grey low.
            box { from: 0, 0; size: 4, words.height + 28; corner: 2; color: if(n.urgency > 1.5, red, if(n.urgency < 0.5, surface2, yellow)) }
            column words {
                at: 14, 14
                gap: 6
                text "{upper(n.app)}" { size: 9; color: overlay0; family: "Berkeley Mono"; width: ts.w - 40; lines: 1 }
                text n.title { size: 12; color: text; family: "Berkeley Mono"; width: ts.w - 28; lines: 2 }
                text n.body { show: n.hasbody; size: 11; color: overlay2; family: "Berkeley Mono"; width: ts.w - 28; lines: 4 }
            }
            text ic.close { at: ts.w - 16, 16; anchor: center; size: 11; color: overlay1; family: "FiraCode Nerd Font"; opacity: ts.hit.hover }
            zone box ts.hit { from: 0, 0; size: ts.w, words.height + 28; corner: 10; cursor: pointer; label: "{n.title}" }
            on press ts.hit { emit ts_dismiss(n.index) }
        }
    }
}
