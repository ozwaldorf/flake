// The task bar: a strip along the bottom of each monitor, one entry per
// window on it, in the order they sit: workspaces top to bottom, columns left
// to right, rows top to bottom. Its ground starts where the rail
// and drawer end, so it slides aside with them. While recording, a red dot
// and the time run at its far end.
part Taskbar {
    // Every window of the desktop, as the window manager sends it (tb.data,
    // then tb_data); `slot` is its slot there, `mon` its monitor.
    model tb.wins max 32 { title: text; icon: image 16, 16; active: bool; urgent: bool; mon: number; slot: number }
    text tb.data = ""
    event tb_data ->
    fact tb.n.0 = 0
    fact tb.n.1 = 0
    fact tb.n.2 = 0
    fact tb.n.3 = 0
    event tb_go ->

    // the recorder (logic/recorder.luau)
    event rec_toggle ->
    fact rec.on = false
    fact rec.secs = 0

    surface tbar {
        // its own names for what the rail works out (a let shared with the
        // rail's copies would be one value for all of them)
        let tb.me = screen.index
        let tb.W = pick(tb.me, mw.0, mw.1, mw.2, mw.3)
        let tb.right = tb.me > 0
        let tb.rv = pick(tb.me, rv.0, rv.1, rv.2, rv.3)
        let tb.railw = sliver + (rail - sliver) * tb.rv
        let tb.push = tb.railw + if(dmon == tb.me, dw, 0)
        let tb.recess = 0.2 + 0.1 * tb.rv + 0.25 * clamp((tb.push - tb.railw) / pagew, 0, 1)
        size: full, 44
        anchor: bottom
        screens: each
        reserve: 44
        level: top

        // its ground: from the rail and drawer to the far edge, whichever side
        // they are on
        let tb.x = if(tb.right, 0, tb.push)
        let tb.w = max(tb.W - tb.push, 0)
        let tb.count = max(pick(tb.me, tb.n.0, tb.n.1, tb.n.2, tb.n.3), 1)
        // Shrunk to share the strip when there are many.
        let tb.room = tb.w - 16 - 80 * rec.on
        let tb.ew = clamp((tb.room - (tb.count - 1) * 4) / tb.count, 28, 200)

        box { from: tb.x, 0; size: tb.w, 44; color: base }
        // Shadows cut into the top and far edges, as a recess.
        group {
            mask: 0, 0 to 0, 10
            opacity: tb.recess
            box { from: tb.x, 0; size: tb.w, 10; color: crust }
        }

        row {
            at: tb.x + 8, 8
            gap: 4
            for w in tb.wins {
                group {
                    show: w.mon == tb.me
                    size: tb.ew, 28
                    prop tb.hot = 0 ~160ms
                    box { from: 0, 0; size: tb.ew, 28; corner: 6; color: surface0; opacity: if(w.active, 1, 0.5 * tb.hot) }
                    image w.icon { at: 6, 6; size: 16, 16 }
                    text w.title {
                        at: 28, 14; anchor: left center; size: 11; family: "Berkeley Mono"
                        width: max(tb.ew - 34, 1); lines: 1
                        color: if(w.active, text, subtext0)
                        show: tb.ew > 40
                    }
                    box { from: 4, 26; size: tb.ew - 8, 2; corner: 1; color: if(w.urgent, red, blue); opacity: w.active or w.urgent }
                    zone box tb.hit { from: 0, 0; size: tb.ew, 28; corner: 6; cursor: pointer; label: "{w.title}" }
                    on enter tb.hit { tb.hot: 1 }
                    on leave tb.hit { tb.hot: 0 }
                    on press tb.hit { emit tb_go(w.index) }
                }
            }
        }

        // recording: a red dot, and how long
        group {
            show: rec.on
            let recx = tb.x + tb.w - 70
            ellipse { at: recx, 22; radius: 5; color: red }
            text "{rec.secs, time}" { at: recx + 12, 22; anchor: left center; size: 11; color: text; family: "Berkeley Mono" }
            zone box rec.stop { from: recx - 10, 4; size: 70, 36; cursor: pointer; label: "Stop recording" }
            on press rec.stop { emit rec_toggle }
        }
    }
}
