                rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * (drag.dx / g.z) * g.kx / uw.$i, 0.1, 1))
                rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * (drag.dy / g.z) * g.ky / uh.$i, 0.15, 1))
            }
            on release grabr.$i {
                dmode = 0
                dslot = -1
            }
            on press grabt.$i {
                focus win.$i
                dslot = i
                dmode = 3
                g.z = zt
                g.ex = 0
                g.ey = -1
                g.x = fgx
                g.y = fgy
                g.w = if(flo, fgw, wp.$i)
                g.h = if(flo, fgh, r.hp.$i)
                g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
            }
            on drag grabt.$i while rs.ok and flo {
                fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * (drag.dx / g.z), 200))
                fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * (drag.dy / g.z), 120))
                fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
            }
