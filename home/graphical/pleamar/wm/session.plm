// A row-tiling window manager: each monitor shows one workspace of rows
// stacked top to bottom. A row is a strip of windows with their own widths,
// centred when it fits; rows have their own heights. A camera per monitor
// pans over the whole of it to the window the keyboard moved to, and the
// wallpaper drifts behind at a fraction of the distance.
//
// The row bookkeeping is generated (gen/rows.plm, from rows.nix); this file
// draws, animates and takes the mouse. Keys are keys.conf's.
language 0.4
import "../gen/theme.plm"

scene Session {
    surface { size: full, full; screens: each max 4 }
    windows win max 16

    let gap = 14
    let strut = 14
    let radius = 10
    // niri's own spring: stiffness 800, critically damped.
    spring niri = 800, 57
    // How far the wallpaper moves for the camera's distance.
    let para = 0.18

    // The frosting behind the windows' glass (blur.wgsl): dual kawase, five
    // halvings and four doublings back, then a grade. values: tap reach,
    // noise, saturation, brightness.
    blur = file "blur.wgsl" {
        passes: down 0.5 repeat 5, up 2 repeat 4, grade 1
        values: 3, 0.02, 1, 1
        reach: 64
    }

    // the pointer's monitor
    fact mon = 0
    // The monitor with the keyboard, even when it shows no window: the one
    // of the focused window, or the one the pointer went onto.
    fact kmon = 0
    // The room the shell's rail and drawer take on each monitor, signed: from
    // the left edge, or (negative) the right. The shell says it (room_set),
    // since its surfaces cannot reserve room per monitor.
    fact room.0 = 0
    fact room.1 = 0
    fact room.2 = 0
    fact room.3 = 0
    on change f.sc while win.focus >= 0 { kmon = f.sc }
    on change win.focus while win.focus >= 0 { kmon = f.sc }
    on change mon { kmon = mon }
    // Onto a monitor showing no window: nothing keeps the keyboard.
    on change mon while pick(mon, m.topslot.0, m.topslot.1, m.topslot.2, m.topslot.3) < 0 { focus win(-1) }
    // The keyboard moved by key or a window opened: the camera follows it. A
    // window focused by the pointer is left where it is.
    fact pan = 0
    fact newpan = 0
    on still pan for 400ms while pan > 0.5 { pan = 0 }
    on still newpan for 600ms while newpan > 0.5 { newpan = 0 }

    // the overview: the whole of a monitor's rows, zoomed out to fit. One per
    // monitor, opened on the one with the keyboard (or the one the shell
    // names: overview_on and overview_off take the monitor).
    fact ov.0 = false
    fact ov.1 = false
    fact ov.2 = false
    fact ov.3 = false
    prop ovp.0 = 0 ~niri
    prop ovp.1 = 0 ~niri
    prop ovp.2 = 0 ~niri
    prop ovp.3 = 0 ~niri
    event overview
    event overview_on
    event overview_off
    // Held: Super still down 300 ms after the overview opened, so letting go
    // of it picks the selected window (the hovered one), as Alt-Tab does. A
    // quick press leaves it open.
    fact ovh.0 = false
    fact ovh.1 = false
    fact ovh.2 = false
    fact ovh.3 = false
    // Hover only picks once the mouse has moved: the windows shrinking under
    // a still pointer as the overview opens are not a choice.
    fact ovarm = false
    on change cursor.x { ovarm = true }
    on change cursor.y { ovarm = true }
    repeat s in 0..4 {
        follow ovp.$s = if(ov.$s, 1, 0)
        on still ov.$s for 300ms while ov.$s and keys.super > 0.5 { ovh.$s = true }
        on change ov.$s while not ov.$s { ovh.$s = false }
        on change ov.$s while ov.$s { ovarm = false }
        on still keys.super for 35ms while keys.super < 0.5 and ovh.$s {
            ov.$s = false
            ovh.$s = false
        }
        on overview while kmon == s { toggle ov.$s }
        on overview_on(v) while v == s { ov.$s = true }
        on overview_off(v) while v == s { ov.$s = false }
        on key Escape while ov.$s { ov.$s = false }
    }

    // dragging with Super held: 1 moves, 2 pans the camera, 3 resizes
    // Super held, as the compositor says.
    fact keys.super = 0
    fact dslot = -1
    fact dmode = 0
    fact g.x = 0
    fact g.y = 0
    fact g.w = 0
    fact g.h = 0
    // which sides a resize moves: -1 the left or top, 1 the right or bottom
    fact g.ex = 0
    fact g.ey = 0
    // How far a tiled edge moves for the pointer's: a centred row or stack
    // grows on both sides, so half as far.
    fact g.kx = 1
    fact g.ky = 1
    // a carried window: where in it the pointer holds it, where the pointer
    // is (on the monitor it is over), and the window under it
    fact g.ox = 0
    fact g.oy = 0
    fact g.px = 0
    fact g.py = 0
    // the monitor the drag started on, and where each copy sits (see desk)
    fact g.hs = 0
    fact org.0 = 0
    fact org.1 = 0
    fact org.2 = 0
    fact org.3 = 0
    fact dropj = -1
    fact t.c = 0
    fact t.r = 0
    fact t.h = 0
    fact wcool = 0
    on still wcool for 150ms while wcool > 0.5 { wcool = 0 }

    include "../gen/rows.plm"
    // each monitor's left edge on the desktop, the monitors side by side in
    // their order: a carried window is drawn on all of them, shifted by this
    let mx.0 = 0
    let mx.1 = W.0
    let mx.2 = mx.1 + W.1
    let mx.3 = mx.2 + W.2

    // each monitor: its camera on springs, still in the overview
    repeat s in 0..4 {
        follow vx.$s = if(ov.$s, 0, cam.tx.$s)
        follow vy.$s = if(ov.$s, 0, cam.ty.$s)
        // A workspace shown on the monitor with the keyboard gives it to the
        // window there that had it last.
        on still win.pool.$s for 60ms while kmon == s and m.topslot.$s >= 0 and (win.focus < 0 or (f.sc == s and f.pool != win.pool.$s)) { focus win(m.topslot.$s) }
    }
    // How far out the overview goes: the widest row and the whole stack in view,
    // in what the shell's drawer leaves of the monitor.
    let zf.0 = min(1, min(max(avail.0 - abs(room.0), 1) / max(m.rw.0, 1), Ha.0 / max(m.th.0, 1))) * 0.92
    let zf.1 = min(1, min(max(avail.1 - abs(room.1), 1) / max(m.rw.1, 1), Ha.1 / max(m.th.1, 1))) * 0.92
    let zf.2 = min(1, min(max(avail.2 - abs(room.2), 1) / max(m.rw.2, 1), Ha.2 / max(m.th.2, 1))) * 0.92
    let zf.3 = min(1, min(max(avail.3 - abs(room.3), 1) / max(m.rw.3, 1), Ha.3 / max(m.th.3, 1))) * 0.92
    // Each monitor's zoom as it stands. The camera (vx, vy) springs in screen
    // space, on the same spring as the zoom, and the windows divide it back
    // by this: zooming in and panning together then move every window in a
    // straight line, not the curve two springs in a row make.
    let zm.0 = 1 - (1 - zf.0) * ovp.0
    let zm.1 = 1 - (1 - zf.1) * ovp.1
    let zm.2 = 1 - (1 - zf.2) * ovp.2
    let zm.3 = 1 - (1 - zf.3) * ovp.3
    // The keyboard handed to a window out of sight: let go, so the rule below
    // gives it to one that is shown.
    // (Not in an overview, where every workspace is shown and can be picked.)
    on still win.focus for 100ms while f.live and not f.vis and not (ov.0 or ov.1 or ov.2 or ov.3) { focus win(-1) }
    // Nobody has the keyboard while windows are shown where it is.
    on still win.focus for 80ms while win.focus < 0 and pick(kmon, m.topslot.0, m.topslot.1, m.topslot.2, m.topslot.3) >= 0 { focus win(pick(kmon, m.topslot.0, m.topslot.1, m.topslot.2, m.topslot.3)) }

    let me = screen.index
    // this monitor's overview
    let ov = pick(me, ov.0, ov.1, ov.2, ov.3)
    let ovp = pick(me, ovp.0, ovp.1, ovp.2, ovp.3)
    let Wm = screen.width
    let Hm = screen.height

    // the wallpaper: two slots crossfading, already graded to the palette and
    // cropped to 16:9 by the logic. It drifts with the camera (parallax), and
    // slides with the shell's drawer.
    permissions { run: "pleamar-wallpaper", "pleamar", "sh" }
    text wall.a = ""
    text wall.b = ""
    // A path the shell asks for (`text wall.req ...`, then `emit wall_set`).
    text wall.req = ""
    fact wall.pick = 0
    prop wall.mix = 0 ~1600ms
    follow wall.mix = wall.pick
    event wall_next ->
    event wall_set ->
    image wall.ia = from wall.a, 1920, 1080
    image wall.ib = from wall.b, 1920, 1080
    // While the next one is fetched and graded, what is up breathes.
    fact wall.busy = false
    fact wall.ph = 0
    every 700ms while wall.busy { wall.ph = 1 - wall.ph }
    prop wall.pulse = 0 ~700ms
    follow wall.pulse = if(wall.busy, wall.ph, 0)
    let wall.lit = 1 - 0.35 * wall.pulse
    // The drawer's push, one spring per monitor: a spring followed from every
    // monitor's copy is one value they fight over.
    prop wv.p.0 = 0 ~niri
    prop wv.p.1 = 0 ~niri
    prop wv.p.2 = 0 ~niri
    prop wv.p.3 = 0 ~niri
    repeat s in 0..4 {
        follow wv.p.$s = win.reserved.$s.left - win.reserved.$s.right + room.$s
    }
    // Bigger than the monitor by what the parallax may reach, which it
    // follows on the camera's own springs.
    let wv.w = max(Wm, Hm * 16 / 9) * 1.2
    let wv.h = wv.w * 9 / 16
    let wv.mx = (wv.w - Wm) / 2
    let wv.my = (wv.h - Hm) / 2
    let wv.ox = clamp(-pick(me, vx.0, vx.1, vx.2, vx.3) * para, -wv.mx, wv.mx) - wv.mx + pick(me, wv.p.0, wv.p.1, wv.p.2, wv.p.3)
    let wv.oy = clamp(-pick(me, vy.0, vy.1, vy.2, vy.3) * para, -wv.my, wv.my) - wv.my
    image wall.ia { at: wv.ox, wv.oy; size: wv.w, wv.h; opacity: (1 - wall.mix) * wall.lit }
    image wall.ib { at: wv.ox, wv.oy; size: wv.w, wv.h; opacity: wall.mix * wall.lit }

    // what the shell is told: the workspace of each monitor, which monitor
    // has the keyboard, whether the overview is open
    text monname.0 = ""
    text monname.1 = ""
    text monname.2 = ""
    text monname.3 = ""
    event ws_report ->
    event focus_report ->
    event ov_report ->
    repeat s in 0..4 {
        let code.$s = s + 4 * (win.shown.$s + 16 * (win.pools.$s + 16 * min(m.count.$s, 1)))
        on change code.$s { emit ws_report(code.$s) }
        on shell_hello { emit ws_report(code.$s) }
    }
    on change kmon { emit focus_report(kmon) }
    // each monitor's size, which the shell's named surfaces cannot read per
    // monitor: s + 4 * the width, and s + 4 * the height (event values are
    // 32-bit floats, so the two are not packed into one)
    event width_report ->
    event height_report ->
    repeat s in 0..4 {
        let wcode.$s = s + 4 * floor(W.$s + 0.5)
        let hcode.$s = s + 4 * floor(H.$s + 0.5)
        on change wcode.$s { emit width_report(wcode.$s) }
        on change hcode.$s { emit height_report(hcode.$s) }
        on shell_hello {
            emit width_report(wcode.$s)
            emit height_report(hcode.$s)
        }
    }
    // the monitor the pointer is on, plus 4 while a window is being dragged
    event ptr_report ->
    let ptr.code = mon + 4 * if(dmode > 0.5, 1, 0)
    on change ptr.code { emit ptr_report(ptr.code) }
    // each monitor's overview: s + 4 while open
    repeat s in 0..4 {
        on change ov.$s { emit ov_report(s + 4 * if(ov.$s, 1, 0)) }
        on shell_hello { emit ov_report(s + 4 * if(ov.$s, 1, 0)) }
    }
    event shell_hello
    on shell_hello {
        emit focus_report(kmon)
        emit ptr_report(ptr.code)
    }
    // the shell's task bar: told again whenever what it shows, or the order
    // windows sit in, changes (the logic sorts and sends it)
    event tb_dirty ->
    event tb_focus
    // a shell that just started is sent the list even if it has not changed
    event tb_hello ->
    on shell_hello { emit tb_hello }
    repeat i in 0..16 {
        on change win.$i.open { emit tb_dirty }
        on change win.$i.focused { emit tb_dirty }
        on change win.$i.urgent { emit tb_dirty }
        on change win.$i.screen { emit tb_dirty }
        on change win.$i.workspace { emit tb_dirty }
        on change rpos.$i { emit tb_dirty }
        on change cpos.$i { emit tb_dirty }
        // Picked in the task bar: the keyboard, and the camera on it.
        on tb_focus(v) while v == i {
            focus win.$i
            pan = 1
        }
    }

    // The middle of this monitor's working area, which the camera centres and
    // the overview zooms on.
    let mid.x = pick(me, Ax.0, Ax.1, Ax.2, Ax.3) + gap + pick(me, avail.0, avail.1, avail.2, avail.3) / 2
    let mid.y = pick(me, Ay.0, Ay.1, Ay.2, Ay.3) + pick(me, Ha.0, Ha.1, Ha.2, Ha.3) / 2
    let zoom = pick(me, zm.0, zm.1, zm.2, zm.3)
    zone box desk { from: 0, 0; size: Wm, Hm }
    on enter desk { mon = screen.index }
    // Where each monitor's copy sits in the scene, learnt while the pointer
    // rests on it: during a drag pointer.y is measured from the copy the
    // press was on, so it is corrected by the difference.
    repeat s in 0..4 {
        on hover desk for 200ms while screen.index == s { org.$s = cursor.y - pointer.y }
    }
    on press desk while ov { ov.$screen = false }
    // Super and a drag on empty desk pans the camera, until the keyboard
    // moves it again.
    on press desk while keys.super > 0.5 and not ov {
        dmode = 2
        dslot = -1
        g.x = pick(me, ofs.x.0, ofs.x.1, ofs.x.2, ofs.x.3)
        g.y = pick(me, ofs.y.0, ofs.y.1, ofs.y.2, ofs.y.3)
    }
    repeat s in 0..4 {
        on drag desk while dmode == 2 and dslot < 0 and me == s {
            ofs.x.$s = g.x - drag.dx
            ofs.y.$s = g.y - drag.dy
        }
    }
    on release desk { dmode = 0 }
    // With Super, the wheel goes through the windows in order: along the
    // row, then on to the next. One step per notch, with the cooldown so a
    // flick does not race.
    on scroll desk while keys.super > 0.5 and not ov and wcool < 0.5 and wheel < 0 and f.on and f.next >= 0 {
        wcool = 1
        pan = 1
        focus win(f.next)
    }
    on scroll desk while keys.super > 0.5 and not ov and wcool < 0.5 and wheel > 0 and f.on and f.prev >= 0 {
        wcool = 1
        pan = 1
        focus win(f.prev)
    }

    group {
        pivot: mid.x, mid.y
        // Centred in what the drawer leaves of the monitor, not slid with the
        // windows by its width (the wallpaper still slides).
        move: ((Wm + pick(me, room.0, room.1, room.2, room.3)) / 2 - mid.x) * ovp, 0
        scale: zoom

        // the windows
        repeat i in 0..16 {
            let sc = win.$i.screen
            let Ws = pick(sc, W.0, W.1, W.2, W.3)
            let Hs = pick(sc, H.0, H.1, H.2, H.3)
            let Ax = pick(sc, Ax.0, Ax.1, Ax.2, Ax.3)
            let Wa = pick(sc, Wa.0, Wa.1, Wa.2, Wa.3)
            let Ay = pick(sc, Ay.0, Ay.1, Ay.2, Ay.3)
            let Ha = pick(sc, Ha.0, Ha.1, Ha.2, Ha.3)
            let avail = pick(sc, avail.0, avail.1, avail.2, avail.3)
            let zsc = max(pick(sc, zm.0, zm.1, zm.2, zm.3), 0.01)
            let camx = pick(sc, vx.0, vx.1, vx.2, vx.3) / zsc
            let camy = pick(sc, vy.0, vy.1, vy.2, vy.3) / zsc
            // the camera settled where it is going
            let still = abs(camx - pick(sc, cam.tx.0, cam.tx.1, cam.tx.2, cam.tx.3)) < 2 and abs(camy - pick(sc, cam.ty.0, cam.ty.1, cam.ty.2, cam.ty.3)) < 2

            let tiled = win.$i.place >= 0
            // Where its row puts it. The camera is not in it: a tiled window's
            // spring follows its place in the rows, and the camera is taken off
            // as it is drawn (camoff), so a pan moves on the camera's one spring,
            // in step with the overview's zoom, not on two in a row.
            let tx = Ax + gap + avail / 2 + lx.$i
            let ty = Ay + Ha / 2 + ly.$i
            let camoff.x = if(tiled and not win.$i.fullscreen, camx, 0)
            let camoff.y = if(tiled and not win.$i.fullscreen, camy, 0)
            // Floating: where it was put; a dialog in the middle at its own size.
            fact fx.$i = 0
            fact fy.$i = 0
            fact fw.$i = 0
            fact fh.$i = 0
            let flo = win.$i.floating or win.$i.dialog
            let dw = max(win.$i.width, 120)
            let dh = max(win.$i.height, 80)
            let fgw = if(win.$i.dialog, dw, max(fw.$i, 200))
            let fgh = if(win.$i.dialog, dh, max(fh.$i, 120))
            let fgx = if(win.$i.dialog or fw.$i < 1, Ax + (Wa - fgw) / 2, fx.$i)
            let fgy = if(win.$i.dialog or fw.$i < 1, (Hs - fgh) / 2, fy.$i)
            let full = win.$i.fullscreen
            // A tiled window being carried leaves its place and follows the mouse.
            let lifted = dmode == 1 and dslot == i and tiled
            // where the pointer's monitor sits from this window's, for a
            // carried window: it is kept in its own monitor's coordinates
            let dmx = pick(mon, mx.0, mx.1, mx.2, mx.3) - pick(sc, mx.0, mx.1, mx.2, mx.3)
            let goal.x = if(full, 0, if(flo, fgx, if(lifted, g.px + dmx - g.ox + camoff.x, tx)))
            let goal.y = if(full, 0, if(flo, fgy, if(lifted, g.py - g.oy + camoff.y, ty)))
            let goal.w = if(full, Ws, if(flo, fgw, tw.$i))
            let goal.h = if(full, Hs, if(flo, fgh, th.$i))

            follow x.$i = goal.x
            follow y.$i = goal.y
            follow w.$i = goal.w
            follow h.$i = goal.h
            // A window that opens fades in where it goes; one that closes fades
            // out where it was. No growing or shrinking.
            prop seen.$i = 0 ~150ms
            // Held back until it has its place (place_new) and the shape around it
            // has settled (nhold), then faded in there.
            follow seen.$i = if(win.$i.open and nw != i and not (nhold > 0.5 and nwl == i), 1, 0)
            // Placed: it starts where it goes, so it fades in without moving.
            on change nhold while nhold < 0.5 and nw != i and win.$i.open and seen.$i < 0.01 {
                x.$i: goal.x ~0ms
                y.$i: goal.y ~0ms
                w.$i: goal.w ~0ms
                h.$i: goal.h ~0ms
            }
            on change win.$i.open while win.$i.open {
                x.$i: goal.x ~0ms
                y.$i: goal.y ~0ms
                w.$i: goal.w ~0ms
                h.$i: goal.h ~0ms
                seen.$i: 0 ~0ms
                stamp.$i = stamp.top + 1
                stamp.top = stamp.top + 1
                // At the end of the focused row until it is placed (place_new).
                rpos.$i = if(f.on, f.rpos, 1000)
                cpos.$i = 1000 + i
                wp.$i = 0.5
                hp.$i = if(f.on, f.hp, 0.5)
                // On the monitor with the keyboard, as niri does: pleamar-wm puts it
                // where the pointer was last seen over the scene, which a
                // pointer over another window leaves stale.
                send win(i) to kmon
                nw = if(win.$i.dialog or win.$i.floating, nw, i)
                nwt = nwt + 1
            }
            on change win.$i.focused while win.$i.focused {
                stamp.$i = stamp.top + 1
                stamp.top = stamp.top + 1
            }
            // Floated by the toggle: 800 by 500, in the middle of its monitor.
            on toggle_float while win.focus == i and not win.$i.floating {
                fw.$i = 800
                fh.$i = 500
                fx.$i = Ax + (Wa - 800) / 2
                fy.$i = (Hs - 500) / 2
            }
            // Floated by a window rule: in the middle at the size it asked for.
            on change win.$i.floating while win.$i.floating and fw.$i < 1 {
                fw.$i = max(win.$i.width, 800)
                fh.$i = max(win.$i.height, 500)
                fx.$i = Ax + (Wa - max(win.$i.width, 800)) / 2
                fy.$i = (Hs - max(win.$i.height, 500)) / 2
            }
            on change win.$i.open while not win.$i.open { fw.$i = 0 }

            // The camera goes to the window the keyboard moved to, and drops
            // any pan by hand.
            repeat s in 0..4 {
                on change win.$i.focused while win.$i.focused and tiled and sc == s and (pan > 0.5 or newpan > 0.5) and nw != i and not cl.pending {
                    cam.a.$s = i
                    ofs.x.$s = 0
                    ofs.y.$s = 0
                }
                // A new window only once it has its place and the shape has settled: before that it sits at the
                // end of a row, and the camera swung there and back.
                on change nhold while nhold < 0.5 and nw != i and win.$i.focused and tiled and sc == s and newpan > 0.5 {
                    cam.a.$s = i
                    ofs.x.$s = 0
                    ofs.y.$s = 0
                }
            }

            let here = sc == me and win.$i.pool == pick(sc, win.pool.0, win.pool.1, win.pool.2, win.pool.3)
            let lit = win.$i.focused
            prop litp.$i = 0 ~160ms
            follow litp.$i = if(lit, 1, 0)
            prop liftp.$i = 0 ~160ms
            follow liftp.$i = if(lifted, 1, 0)
            prop dropp.$i = 0 ~120ms
            follow dropp.$i = if(dmode == 1 and dropj == i, 1, 0)
            let x = x.$i - camoff.x
            let y = y.$i - camoff.y
            let w = w.$i
            let h = h.$i
            let r = if(full, 0, radius)
            group {
                z: if(full, 100000, if(win.$i.dialog, 60000, if(lifted, 90000, if(win.$i.floating, 1000 + stamp.$i, 0))))
                // Carried, it is drawn on every monitor, shifted by where each
                // sits from its own, so it shows across the boundary.
                show: if(dmode == 1 and dslot == i, true, here) and seen.$i > 0.005
                move: if(dmode == 1 and dslot == i, pick(sc, mx.0, mx.1, mx.2, mx.3) - pick(me, mx.0, mx.1, mx.2, mx.3), 0), 0
                opacity: seen.$i
                pivot: x + w / 2, y + h / 2
                scale: 1 - 0.05 * liftp.$i
                // Blur what shows through a translucent window, and a soft
                // shadow cut out around it.
                body {
                    color: base
                    glass: if(full, 0, 100%)
                    refraction: 0
                    dispersion: 0
                    ripple: 0
                    frost: 100%
                    // none of the glass's own colouring: it shows the blur as it is
                    tint: 0
                    vivid: 100%
                    mirror: 0
                    highlight: 0
                    shadow: 0, 5, 30, 44% * (1 - full), crust
                    box { from: x, y; size: w, h; corner: r }
                }
                group {
                    clip box { from: x, y; size: w, h; corner: r }
                    window win.$i { at: x, y; size: w, h; ask: if(win.$i.dialog, 0, goal.w), if(win.$i.dialog, 0, goal.h); show: win.$i.open }
                }
                box { from: x, y; size: w, h; corner: r; stroke: 1; color: mix(base, text, litp.$i); opacity: 1 - full }
                // where a carried window would land: this one, marked
                box { from: x, y; size: w, h; corner: r; color: blue; opacity: 16% * dropp.$i }
                box { from: x, y; size: w, h; corner: r; stroke: 2; color: blue; opacity: dropp.$i }
            }

            // The keyboard follows the pointer, without moving the camera, and
            // only once the camera and the window have settled, so windows
            // sliding under a still pointer do not take it.
            on enter win.$i while not win.$i.focused and dmode < 0.5 and not ov and still and abs(x.$i - goal.x) < 2 and abs(y.$i - goal.y) < 2 {
                mon = screen.index
                focus win.$i
            }
            // In the overview a window is picked with a click, and the camera
            // goes to it even if it already had the keyboard.
            zone box pickw.$i { from: x, y; size: w, h; cursor: pointer; active: ov and here and win.$i.open }
            // Hovered in the overview, it is selected: the keyboard goes to it.
            on enter pickw.$i while ov and ovarm and not win.$i.focused { focus win.$i }
            // and the one already under it, the moment the mouse first moves
            on change ovarm while ovarm and ov and pickw.$i.hover > 0.5 and not win.$i.focused { focus win.$i }
            on press pickw.$i {
                focus win.$i
                ov.$screen = false
            }
            repeat s in 0..4 {
                on press pickw.$i while tiled and sc == s {
                    cam.a.$s = i
                    ofs.x.$s = 0
                    ofs.y.$s = 0
                }
                // Super let go in a held overview: the selected window is picked
                // as a click would, its workspace shown and the camera on it.
                on still keys.super for 30ms while keys.super < 0.5 and win.$i.focused and sc == s and ovh.$s {
                    workspace win.$i.workspace on s
                    cam.a.$s = i
                    ofs.x.$s = 0
                    ofs.y.$s = 0
                }
                // and so does one picked in the task bar
                on tb_focus(v) while v == i and tiled and sc == s {
                    cam.a.$s = i
                    ofs.x.$s = 0
                    ofs.y.$s = 0
                }
            }

            // With Super held the window is a handle: its edges and corners
            // stretch it, the rest carries it. A tiled window's sides set its
            // width, its top and bottom its row's height. Only the left
            // button: pleamar reports no drag or release for the others.
            let edgex = max(min(w / 5, 120), 40)
            let edgey = max(min(h / 5, 120), 40)
            // Held while a drag of it lasts, wherever the pointer went.
            let handle = ((keys.super > 0.5 and here) or dslot == i) and win.$i.open and not full and not ov
            zone box grab.$i { from: x, y; size: w, h; cursor: grab; active: handle }
            zone box grabl.$i { from: x, y; size: edgex, h; cursor: ew_resize; active: handle }
            zone box grabr.$i { from: x + w - edgex, y; size: edgex, h; cursor: ew_resize; active: handle }
            zone box grabt.$i { from: x, y; size: w, edgey; cursor: ns_resize; active: handle }
            zone box grabb.$i { from: x, y + h - edgey; size: w, edgey; cursor: ns_resize; active: handle }
            zone box grabtl.$i { from: x, y; size: edgex, edgey; cursor: nwse_resize; active: handle }
            zone box grabtr.$i { from: x + w - edgex, y; size: edgex, edgey; cursor: nesw_resize; active: handle }
            zone box grabbl.$i { from: x, y + h - edgey; size: edgex, edgey; cursor: nesw_resize; active: handle }
            zone box grabbr.$i { from: x + w - edgex, y + h - edgey; size: edgex, edgey; cursor: nwse_resize; active: handle }
            // Carried from the middle: the edge bands are on top and take
            // their own presses.
            on press grab.$i while pointer.x >= x + edgex and pointer.x < x + w - edgex and pointer.y >= y + edgey and pointer.y < y + h - edgey {
                focus win.$i
                dslot = i
                dmode = 1
                g.hs = sc
                g.ox = pointer.x - if(flo, fgx, x)
                g.oy = pointer.y - if(flo, fgy, y)
                g.px = pointer.x
                g.py = pointer.y
                dropj = -1
            }
            // The pointer is told in the coordinates of the monitor it is on,
            // so the window is held by where it was grabbed, drawn on the
            // monitor the pointer is over, and given to it when let go.
            on drag grab.$i while dmode == 1 {
                g.px = pointer.x
                g.py = pointer.y + pick(g.hs, org.0, org.1, org.2, org.3) - pick(mon, org.0, org.1, org.2, org.3)
            }
            on drag grab.$i while dmode == 1 and flo {
                fx.$i = pointer.x + dmx - g.ox
                fy.$i = pointer.y + pick(g.hs, org.0, org.1, org.2, org.3) - pick(mon, org.0, org.1, org.2, org.3) - g.oy
                fw.$i = fgw
                fh.$i = fgh
            }
            // Carried over another tiled window: that one is marked, and on
            // letting go the two trade places, row heights with them.
            on drag grab.$i while dmode == 1 and tiled { dropj = -1 }
            repeat j in 0..16 {
                on drag grab.$i while dmode == 1 and tiled and mon == sc and j != i and win.$j.place >= 0 and win.$j.screen == sc and win.$j.pool == win.$i.pool and pointer.x + camx >= x.$j and pointer.x + camx < x.$j + w.$j and pointer.y + camy >= y.$j and pointer.y + camy < y.$j + h.$j { dropj = j }
                on release grab.$i while dmode == 1 and tiled and dropj == j {
                    t.c = cpos.$i
                    t.r = rpos.$i
                    t.h = hp.$i
                    cpos.$i = cpos.$j
                    rpos.$i = rpos.$j
                    hp.$i = hp.$j
                    cpos.$j = t.c
                    rpos.$j = t.r
                    hp.$j = t.h
                }
            }
            // Let go on another monitor: it goes there, its place turned into
            // that monitor's coordinates at once, so it does not glide across.
            on release grab.$i while dmode == 1 and mon != sc {
                fx.$i = fx.$i - dmx
                // (from this monitor's rows to that one's: each camera off and on)
                x.$i: x.$i - camoff.x - dmx + if(tiled, pick(mon, vx.0, vx.1, vx.2, vx.3), 0) ~0ms
                y.$i: y.$i - camoff.y + if(tiled, pick(mon, vy.0, vy.1, vy.2, vy.3), 0) ~0ms
                send win(i) to mon
            }
            on release grab.$i {
                dmode = 0
                dslot = -1
                dropj = -1
            }

            // Stretched by an edge or a corner: g.ex, g.ey say which sides
            // move (-1 the left or top, 1 the right or bottom), the others
            // stay put. Only while the pointer is on its monitor: off it, the
            // pointer is told in another monitor's coordinates (its y off by
            // where that copy sits), and the size holds until it comes back.
            // The y is checked too, since the move that crosses arrives before
            // the monitor under the pointer changes.
            let rs.ok = dmode == 3 and dslot == i and mon == sc and pointer.y >= 0 and pointer.y <= Hs
            on press grabl.$i {
                focus win.$i
                dslot = i
                dmode = 3
                g.ex = -1
                g.ey = 0
                g.x = fgx
                g.y = fgy
                g.w = if(flo, fgw, wp.$i)
                g.h = if(flo, fgh, r.hp.$i)
                g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
            }
            on drag grabl.$i while rs.ok and flo {
                fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * drag.dx, 200))
                fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * drag.dy, 120))
                fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
            }
            on drag grabl.$i while rs.ok and tiled {
                rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * drag.dx * g.kx / uw.$i, 0.1, 1))
                rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * drag.dy * g.ky / uh.$i, 0.15, 1))
            }
            on release grabl.$i {
                dmode = 0
                dslot = -1
            }
            on press grabr.$i {
                focus win.$i
                dslot = i
                dmode = 3
                g.ex = 1
                g.ey = 0
                g.x = fgx
                g.y = fgy
                g.w = if(flo, fgw, wp.$i)
                g.h = if(flo, fgh, r.hp.$i)
                g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
            }
            on drag grabr.$i while rs.ok and flo {
                fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * drag.dx, 200))
                fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * drag.dy, 120))
                fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
            }
            on drag grabr.$i while rs.ok and tiled {
                rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * drag.dx * g.kx / uw.$i, 0.1, 1))
                rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * drag.dy * g.ky / uh.$i, 0.15, 1))
            }
            on release grabr.$i {
                dmode = 0
                dslot = -1
            }
            on press grabt.$i {
                focus win.$i
                dslot = i
                dmode = 3
                g.ex = 0
                g.ey = -1
                g.x = fgx
                g.y = fgy
                g.w = if(flo, fgw, wp.$i)
                g.h = if(flo, fgh, r.hp.$i)
                g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
            }
            on drag grabt.$i while rs.ok and flo {
                fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * drag.dx, 200))
                fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * drag.dy, 120))
                fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
            }
            on drag grabt.$i while rs.ok and tiled {
                rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * drag.dx * g.kx / uw.$i, 0.1, 1))
                rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * drag.dy * g.ky / uh.$i, 0.15, 1))
            }
            on release grabt.$i {
                dmode = 0
                dslot = -1
            }
            on press grabb.$i {
                focus win.$i
                dslot = i
                dmode = 3
                g.ex = 0
                g.ey = 1
                g.x = fgx
                g.y = fgy
                g.w = if(flo, fgw, wp.$i)
                g.h = if(flo, fgh, r.hp.$i)
                g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
            }
            on drag grabb.$i while rs.ok and flo {
                fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * drag.dx, 200))
                fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * drag.dy, 120))
                fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
            }
            on drag grabb.$i while rs.ok and tiled {
                rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * drag.dx * g.kx / uw.$i, 0.1, 1))
                rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * drag.dy * g.ky / uh.$i, 0.15, 1))
            }
            on release grabb.$i {
                dmode = 0
                dslot = -1
            }
            on press grabtl.$i {
                focus win.$i
                dslot = i
                dmode = 3
                g.ex = -1
                g.ey = -1
                g.x = fgx
                g.y = fgy
                g.w = if(flo, fgw, wp.$i)
                g.h = if(flo, fgh, r.hp.$i)
                g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
            }
            on drag grabtl.$i while rs.ok and flo {
                fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * drag.dx, 200))
                fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * drag.dy, 120))
                fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
            }
            on drag grabtl.$i while rs.ok and tiled {
                rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * drag.dx * g.kx / uw.$i, 0.1, 1))
                rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * drag.dy * g.ky / uh.$i, 0.15, 1))
            }
            on release grabtl.$i {
                dmode = 0
                dslot = -1
            }
            on press grabtr.$i {
                focus win.$i
                dslot = i
                dmode = 3
                g.ex = 1
                g.ey = -1
                g.x = fgx
                g.y = fgy
                g.w = if(flo, fgw, wp.$i)
                g.h = if(flo, fgh, r.hp.$i)
                g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
            }
            on drag grabtr.$i while rs.ok and flo {
                fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * drag.dx, 200))
                fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * drag.dy, 120))
                fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
            }
            on drag grabtr.$i while rs.ok and tiled {
                rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * drag.dx * g.kx / uw.$i, 0.1, 1))
                rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * drag.dy * g.ky / uh.$i, 0.15, 1))
            }
            on release grabtr.$i {
                dmode = 0
                dslot = -1
            }
            on press grabbl.$i {
                focus win.$i
                dslot = i
                dmode = 3
                g.ex = -1
                g.ey = 1
                g.x = fgx
                g.y = fgy
                g.w = if(flo, fgw, wp.$i)
                g.h = if(flo, fgh, r.hp.$i)
                g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
            }
            on drag grabbl.$i while rs.ok and flo {
                fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * drag.dx, 200))
                fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * drag.dy, 120))
                fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
            }
            on drag grabbl.$i while rs.ok and tiled {
                rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * drag.dx * g.kx / uw.$i, 0.1, 1))
                rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * drag.dy * g.ky / uh.$i, 0.15, 1))
            }
            on release grabbl.$i {
                dmode = 0
                dslot = -1
            }
            on press grabbr.$i {
                focus win.$i
                dslot = i
                dmode = 3
                g.ex = 1
                g.ey = 1
                g.x = fgx
                g.y = fgy
                g.w = if(flo, fgw, wp.$i)
                g.h = if(flo, fgh, r.hp.$i)
                g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
            }
            on drag grabbr.$i while rs.ok and flo {
                fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * drag.dx, 200))
                fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * drag.dy, 120))
                fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
            }
            on drag grabbr.$i while rs.ok and tiled {
                rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * drag.dx * g.kx / uw.$i, 0.1, 1))
                rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * drag.dy * g.ky / uh.$i, 0.15, 1))
            }
            on release grabbr.$i {
                dmode = 0
                dslot = -1
            }
            // A tiled window's width follows its sides while they are dragged.
            on change rsw while dmode == 3 and dslot == i and tiled { wp.$i = rsw }
        }
    }

    // actions, bound in keys.conf
    event close
    event fullscreen
    event toggle_float
    event focus_left
    event focus_right
    event focus_up
    event focus_down
    event move_left
    event move_right
    event move_up
    event move_down
    event cycle_width
    event cycle_height
    on close while win.focus >= 0 { close win(win.focus) }
    on fullscreen while win.focus >= 0 { fullscreen win(win.focus) }
    on toggle_float while win.focus >= 0 and not f.on and pick(f, win.0.floating, win.1.floating, win.2.floating, win.3.floating, win.4.floating, win.5.floating, win.6.floating, win.7.floating, win.8.floating, win.9.floating, win.10.floating, win.11.floating, win.12.floating, win.13.floating, win.14.floating, win.15.floating) > 0.5 { tile win(win.focus) }
    on toggle_float while win.focus >= 0 and f.on { float win(win.focus) }
    // From the shell's rail: monitor + 4 * workspace.
    event workspace_on
    on workspace_on(c) { workspace floor(c / 4) on mod(c, 4) }
    on still nwt for 80ms while nw >= 0 { emit place_new }
}
