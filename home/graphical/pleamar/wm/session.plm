                focus win.$i
                dslot = i
                dmode = 3
                g.z = zt
                g.ex = -1
                g.ey = 1
                g.x = fgx
                g.y = fgy
                g.w = if(flo, fgw, wp.$i)
                g.h = if(flo, fgh, r.hp.$i)
                g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
            }
            on drag grabbl.$i while rs.ok and flo {
                fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * (drag.dx / g.z), 200))
                fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * (drag.dy / g.z), 120))
                fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
            }
            on drag grabbl.$i while rs.ok and tiled {
                rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * (drag.dx / g.z) * g.kx / uw.$i, 0.1, 1))
                rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * (drag.dy / g.z) * g.ky / uh.$i, 0.15, 1))
            }
            on release grabbl.$i {
                dmode = 0
                dslot = -1
            }
            on press grabbr.$i {
                focus win.$i
                dslot = i
                dmode = 3
                g.z = zt
                g.ex = 1
                g.ey = 1
                g.x = fgx
                g.y = fgy
                g.w = if(flo, fgw, wp.$i)
                g.h = if(flo, fgh, r.hp.$i)
                g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
            }
            on drag grabbr.$i while rs.ok and flo {
                fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * (drag.dx / g.z), 200))
                fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * (drag.dy / g.z), 120))
                fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
            }
            on drag grabbr.$i while rs.ok and tiled {
                rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * (drag.dx / g.z) * g.kx / uw.$i, 0.1, 1))
                rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * (drag.dy / g.z) * g.ky / uh.$i, 0.15, 1))
            }
            on release grabbr.$i {
                dmode = 0
                dslot = -1
            }
            // A tiled window's width follows its sides while they are dragged.
            on change rsw while dmode == 3 and dslot == i and tiled { wp.$i = rsw }
        }
    }

    // actions, bound in keys.conf
    event close
    event fullscreen
    event toggle_float
    event focus_left
    event focus_right
    event focus_up
    event focus_down
    event move_left
    event move_right
    event move_up
    event move_down
    event cycle_width
    event cycle_height
    // Each monitor by its index: the keyboard to the window that had it there
    // last (or to the monitor, if it shows none), or the focused window sent
    // there.
    event focus_monitor
    event move_monitor
    repeat s in 0..4 {
        on focus_monitor(v) while v == s and s < screens.count and m.topslot.$s >= 0 {
            pan = 1
            focus win(m.topslot.$s)
        }
        on focus_monitor(v) while v == s and s < screens.count and m.topslot.$s < 0 {
            kmon = s
            focus win(-1)
        }
        on move_monitor(v) while v == s and s < screens.count and win.focus >= 0 and f.sc != s {
            sendir = if(s > f.sc, 1, -1)
            ksend = win.focus
            send win(win.focus) to s
        }
    }
    on close while win.focus >= 0 { close win(win.focus) }
    on fullscreen while win.focus >= 0 { fullscreen win(win.focus) }
    on toggle_float while win.focus >= 0 and not f.on and pick(f, win.0.floating, win.1.floating, win.2.floating, win.3.floating, win.4.floating, win.5.floating, win.6.floating, win.7.floating, win.8.floating, win.9.floating, win.10.floating, win.11.floating, win.12.floating, win.13.floating, win.14.floating, win.15.floating) > 0.5 { tile win(win.focus) }
    on toggle_float while win.focus >= 0 and f.on { float win(win.focus) }
    // From the shell's rail: monitor + 4 * workspace.
    event workspace_on
    on workspace_on(c) { workspace floor(c / 4) on mod(c, 4) }
    on still nwt for 80ms while nw >= 0 { emit place_new }

    // An agent's cursors (`agent on` in session.conf): pleamar-wm says where
    // each is, on which monitor, and when it presses; they are drawn here, on
    // a surface of their own over everything, the programs' menus too, and
    // clicks go through. A ring where it clicks, and its name beside it. They
    // stay while the agent is at work and fade after.
    // Its picture: the user's cursor, every frame, tinted blue
    // (gen/agent-cursor.plm, from the cursor theme), on a clock in ms the logic
    // keeps while an agent is at work (a `spin` here runs once per monitor).
    fact agc.clock = 0
    include "../gen/agent-cursor.plm"
    text agent.name = "agent"
    fact agent.active = 0
    fact agent.win = -1
    fact agent.screen = -1
    fact agent.seen = 0
    // pleamar-wm says agent.active only when it changes, so a scene reloaded
    // while an agent works would not know: a cursor seen lately counts too.
    fact ag.recent = false
    on change agent.0.seen { ag.recent = true }
    on change agent.1.seen { ag.recent = true }
    on still agent.0.seen for 90000ms while ag.recent and not agent.active { ag.recent = false }
    let ag.live = agent.active or ag.recent
    // The window it last worked on, outlined in the windows' loop; an action
    // on a monitor rather than a window (agent.win -1) leaves it.
    fact ag.win = -1
    on change agent.win while agent.win >= 0 { ag.win = agent.win }
    fact agent.0.x = 0
    fact agent.0.y = 0
    fact agent.0.screen = 0
    fact agent.0.down = 0
    fact agent.0.seen = 0
    fact agent.1.x = 0
    fact agent.1.y = 0
    fact agent.1.screen = 0
    fact agent.1.down = 0
    fact agent.1.seen = 0
    surface agent_hands {
        size: full, full
        anchor: top_left
        level: overlay
        screens: each max 4
        open: ag.live
        repeat k in 0..2 {
            // pleamar-wm moves it along the way, as a hand would: this only
            // smooths the steps.
            prop ag.$k.x = 0 ~140ms
            prop ag.$k.y = 0 ~140ms
            prop ag.$k.on = 0 ~220ms
            prop ag.$k.press = 0 ~90ms
            prop ag.$k.ring = 1 ~560ms
            follow ag.$k.x = agent.$k.x
            follow ag.$k.y = agent.$k.y
            follow ag.$k.press = agent.$k.down
            // Seen again, or on another monitor: there at once, not flying in.
            on change agent.$k.seen while ag.$k.on < 0.05 {
                ag.$k.x: agent.$k.x ~0ms
                ag.$k.y: agent.$k.y ~0ms
            }
            on change agent.$k.screen {
                ag.$k.x: agent.$k.x ~0ms
                ag.$k.y: agent.$k.y ~0ms
            }
            on change agent.$k.seen { ag.$k.on: 1 }
            on change ag.live while not ag.live { ag.$k.on: 0 ~900ms }
            on change agent.$k.down while agent.$k.down > 0.5 {
                ag.$k.ring: 0 ~0ms
                ag.$k.ring: 1 after 16ms
            }
            let ax = ag.$k.x
            let ay = ag.$k.y
            measure tag.$k
            group {
                show: ag.$k.on > 0.01 and agent.$k.screen == screen.index
                opacity: ag.$k.on
                ellipse { at: ax, ay; radius: 4 + 22 * ag.$k.ring; stroke: 2.2 * (1 - ag.$k.ring) + 0.4; color: if(k == 0, teal, lavender); opacity: 80% * (1 - ag.$k.ring) }
                group {
                    pivot: ax, ay
                    scale: 1 - 0.12 * ag.$k.press, 1 - 0.12 * ag.$k.press
                    // the user's own cursor, tinted blue, its tip on the point
                    image agc.sheet { at: ax - agc.hx, ay - agc.hy; size: agc.cell, agc.cell; cell: agc.frame, agc.cols, agc.rows }
                }
                // Its name underneath, centred on the hand.
                let tx = ax - agc.hx + agc.cell / 2
                let ty = ay - agc.hy + agc.cell + 2
                box { from: tx - tag.$k.width / 2 - 8, ty; size: tag.$k.width + 16, 18; corner: 9; color: crust; opacity: 85% }
                text agent.name { at: tx, ty + 9.5; anchor: center; size: 10; weight: 600; color: mix(#ffffff, blue, 0.4); family: "Berkeley Mono"; measure: tag.$k }
            }
        }
    }
}
