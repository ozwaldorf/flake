// A row-tiling window manager: each monitor shows one workspace of rows
// stacked top to bottom. A row is a strip of windows with their own widths,
// centred when it fits; rows have their own heights. A camera per monitor
// pans over the whole of it to the window the keyboard moved to, and the
// wallpaper drifts behind at a fraction of the distance.
//
// The row bookkeeping is rows.plm; this file draws, animates and takes the
// mouse. Keys are keys.conf's.
language 0.4
import "../gen/theme.plm"

scene Session {
    surface { size: full, full; screens: each max 4 }
    windows win max 16 placement manual

    let gap = 18
    // the title bar each window gets above what its program draws
    let tbar = 28
    // its buttons, from the icon theme as a GTK header bar would
    image btn.close = icon "window-close-symbolic", 16, 16
    image btn.max = icon "window-maximize-symbolic", 16, 16
    image btn.restore = icon "window-restore-symbolic", 16, 16
    let strut = 14
    let radius = 10
    // niri's own spring: stiffness 800, critically damped.
    spring niri = 800, 57
    // How far the wallpaper moves for the camera's distance.
    let para = 0.08

    // The frosting behind the windows' glass (blur.wgsl): a lens blur, a disc
    // at a quarter of the size, grain at full. values: radius, grain,
    // highlight boost. The radius grows like a magnifier lifted off the page
    // as the camera pulls away (the overview).
    blur = file "blur.wgsl" {
        passes: down 0.5 repeat 2, disc 1, soft 1, grain 4
        values: 40 * (1 + 0.5 * ovp[screen.index]), 0.03, 5
        reach: 64
    }

    // The one glass of the desktop: the windows', their menus', the bars'
    // and the desk's veil. A lens blur (blur.wgsl), a disc at a quarter of
    // the size, grain at full; values: radius, grain, highlight boost. The
    // radius grows like a magnifier lifted off the page as the camera pulls
    // away (the overview of the monitor with the keyboard).
    // material default {
    //     blur: file "blur.wgsl" {
    //         passes: down 0.5 repeat 2, disc 1, soft 1, grain 4
    //         values: 40 * (1 + 0.5 * ovp[kmon]), 0.03, 5
    //     }
    //     reach: 64
    //     frost: 100%
    //     tint: 0
    //     vivid: 140%
    //     smoke: 40%
    //     milk: 20%
    //     refraction: 0
    //     dispersion: 0
    //     dome: 70%
    //     ripple: 0
    //     mirror: 0
    //     highlight: 0
    // }

    // the pointer's monitor
    fact mon = 0
    // The monitor with the keyboard, even when it shows no window: the one
    // of the focused window, or the one the pointer went onto.
    fact kmon = 0
    // The shell opens its drawer with an overview and closes it after, and
    // says so a moment later: the room is taken at once, so the zoom and the
    // windows' slide start together.
    let ovroom = 432
    repeat s in 0..4 {
        // The room the shell's rail and drawer take on each monitor, signed:
        // from the left edge, or (negative) the right. The shell says it
        // (room_set), since its surfaces cannot reserve room per monitor.
        fact room.$s = 0
        // The shell's rail, kept clear on each monitor, signed the same way:
        // the working area narrows by it instead of sliding aside.
        fact edge.$s = 0
        // ovdr: the overview opened the drawer. ovkeep: the shell closed the
        // overview but keeps the drawer open (it went to another page), so
        // its room stays.
        fact ovkeep.$s = false
        fact ovdr.$s = false
        fact ovsh.$s = false
        // What the zoom and its centre read, on springs: a room told mid-zoom
        // moves them instead of jumping.
        prop rs.$s = 0 ~niri
    }
    let rfree = abs(room.0) < 400 and abs(room.1) < 400 and abs(room.2) < 400 and abs(room.3) < 400
    repeat s in 0..4 {
        follow rs.$s = room.$s
        on change ov.$s while ov.$s and rfree {
            room.$s = if(s > 0.5, -ovroom, ovroom)
            ovdr.$s = true
        }
        on change ov.$s while not ov.$s and ovdr.$s and not ovkeep.$s { room.$s = 0 }
        on change ov.$s while not ov.$s { ovdr.$s = false }
        on change ov.$s while ov.$s { ovkeep.$s = false }
        // The shell opened its drawer for the overview (Super+Esc): it closes
        // it once told the overview closed, a few frames later, however it
        // closed (a click, Super let go). Its room counts as gone from then.
        on change ov.$s while ov.$s and not ovdr.$s and abs(room.$s) >= 400 { ovsh.$s = true }
        on change ov.$s while not ov.$s and ovkeep.$s { ovsh.$s = false }
        on change room.$s while ovsh.$s and not ov.$s and abs(room.$s) < 400 { ovsh.$s = false }
        on still ov.$s for 500ms while ovsh.$s and not ov.$s { ovsh.$s = false }
    }
    // The room as it is about to be: the drawer the overview opens or closes
    // counted from the frame the overview turns, not the next one, when the
    // rules above set it. Where the windows go reads this, so their target
    // does not move twice.
    let rmt[4]
    repeat s in 0..4 {
        rmt[s] = if(ov.$s and not ovdr.$s and rfree, if(s > 0.5, -ovroom, ovroom), if(not ov.$s and (ovdr.$s or ovsh.$s) and not ovkeep.$s, 0, room.$s))
    }
    on change f.sc while win.focus >= 0 { kmon = f.sc }
    on change win.focus while win.focus >= 0 { kmon = f.sc }
    on change mon { kmon = mon }
    // Onto a monitor showing no window: nothing keeps the keyboard.
    on change mon while m.topslot[mon] < 0 { focus win(-1) }
    // The keyboard moved by key or a window opened: the camera follows it. A
    // window focused by the pointer is left where it is.
    fact pan = 0
    fact newpan = 0
    on still pan for 400ms while pan > 0.5 { pan = 0 }
    on still newpan for 600ms while newpan > 0.5 { newpan = 0 }

    // the overview: the whole of a monitor's rows, zoomed out to fit. One per
    // monitor, opened on the one with the keyboard (or the one the shell
    // names: overview_on and overview_off take the monitor).
    event overview
    event overview_on
    event overview_off
    // Hover only picks once the mouse has moved: the windows shrinking under
    // a still pointer as the overview opens are not a choice.
    fact ovarm = false
    on change cursor.x { ovarm = true }
    on change cursor.y { ovarm = true }
    repeat s in 0..4 {
        fact ov.$s = false
        prop ovp.$s = 0 ~niri
        // Held: Super still down 300 ms after the overview opened, so letting
        // go of it picks the selected window (the hovered one), as Alt-Tab
        // does. A quick press leaves it open.
        fact ovh.$s = false
        follow ovp.$s = if(ov.$s, 1, 0)
        on still ov.$s for 300ms while ov.$s and keys.super > 0.5 { ovh.$s = true }
        on change ov.$s while not ov.$s { ovh.$s = false }
        on change ov.$s while ov.$s { ovarm = false }
        on still keys.super for 35ms while keys.super < 0.5 and ovh.$s and dmode < 0.5 {
            ov.$s = false
            ovh.$s = false
        }
        on overview while kmon == s { toggle ov.$s }
        on overview_on(v) while v == s { ov.$s = true }
        on overview_off(v) while v == s { ov.$s = false }
        on key Escape while ov.$s { ov.$s = false }
    }

    // dragging with Super held: 1 moves, 2 pans the camera, 3 resizes
    // Super held, as the compositor says.
    fact keys.super = 0
    fact dslot = -1
    fact dmode = 0
    fact g.x = 0
    fact g.y = 0
    fact g.w = 0
    fact g.h = 0
    // which sides a resize moves: -1 the left or top, 1 the right or bottom
    fact g.ex = 0
    fact g.ey = 0
    // How far a tiled edge moves for the pointer's: a centred row or stack
    // grows on both sides, so half as far.
    fact g.kx = 1
    fact g.ky = 1
    // a carried window: where in it the pointer holds it, where the pointer
    // is (on the monitor it is over), and the window under it
    fact g.oy = 0
    // ...and as shares of its size, so a window that changes size as it is
    // carried (put back from maximized) stays held by the same spot. Held by
    // its title bar (g.bar), the height stays in pixels: the bar does not grow.
    fact g.fx = 0.5
    fact g.fy = 0.5
    fact g.bar = 0
    // the window last held: it shrinks as it lifts around that spot
    fact g.last = -1
    // the overview's zoom when a stretch began: the pointer's travel is taken out
    // of it, so the edge stays under the pointer
    fact g.z = 1
    fact g.px = 0
    fact g.py = 0
    // the monitor the drag started on, and where each copy sits (see desk):
    // until learnt, where the compiler stacks them
    fact g.hs = 0
    fact org.0 = 0
    fact org.1 = 10000
    fact org.2 = 20000
    fact org.3 = 30000
    fact dropj = -1
    // where on it: -1 before it, 1 after it (its outer quarters), 0 in its place
    fact dside = 0
    fact t.c = 0
    fact t.r = 0
    fact t.h = 0
    fact wcool = 0
    on still wcool for 150ms while wcool > 0.5 { wcool = 0 }

    include "rows.plm"

    // each monitor's left edge on the desktop, the monitors side by side in
    // their order: a carried window is drawn on all of them, shifted by this
    // ...or where each really sits, once the logic has asked the compositor:
    // shifted down by it too, a window across an edge where the monitors'
    // tops do not line up stays in one piece
    fact mpos.ok = false
    repeat s in 0..4 {
        fact mpos.x.$s = 0
        fact mpos.y.$s = 0
    }
    let mxa = 0
    let mx[4]
    let my[4]
    repeat s in 0..4 {
        mx[s] = if(mpos.ok, mpos.x.$s, mxa)
        my[s] = if(mpos.ok, mpos.y.$s, 0)
        mxa += W[s]
    }

    // each monitor: its camera on springs, still in the overview
    // How far out the overview goes: the widest row and the whole stack in
    // view, in what the shell's drawer leaves of the monitor (zf), and where
    // it is going: from the room the drawer takes, not its spring (zt). zm:
    // each monitor's zoom as it stands: the camera's spring (vx, vy) is in
    // screen space, and read through it to tell when it has settled.
    let zf[4]
    let zt[4]
    let zm[4]
    repeat s in 0..4 {
        follow vx.$s = if(ov.$s, 0, cam.tx.$s)
        follow vy.$s = if(ov.$s, 0, cam.ty.$s)
        // A workspace shown on the monitor with the keyboard gives it to the
        // window there that had it last.
        on still win.pool.$s for 60ms while kmon == s and m.topslot.$s >= 0 and (win.focus < 0 or (f.sc == s and f.pool != win.pool.$s)) { focus win(m.topslot.$s) }
        zf[s] = min(1, min(max(avail[s] - abs(rs.$s), 1) / max(m.rw[s], 1), Ha[s] / max(m.th[s], 1))) * 0.92
        zt[s] = min(1, min(max(avail[s] - abs(rmt[s]), 1) / max(m.rw[s], 1), Ha[s] / max(m.th[s], 1))) * 0.92
        zm[s] = 1 - (1 - zf[s]) * ovp.$s
    }
    let anyov = ov.0 or ov.1 or ov.2 or ov.3
    // The keyboard handed to a window out of sight: let go, so the rule below
    // gives it to one that is shown.
    // (Not in an overview, where every workspace is shown and can be picked.)
    on still win.focus for 100ms while f.live and not f.vis and not anyov { focus win(-1) }
    // Nobody has the keyboard while windows are shown where it is.
    on still win.focus for 80ms while win.focus < 0 and m.topslot[kmon] >= 0 { focus win(m.topslot[kmon]) }

    let me = screen.index
    // this monitor's overview
    let ov = ov[me]
    let ovp = ovp[me]
    let Wm = screen.width
    let Hm = screen.height

    // the wallpaper: two slots crossfading, already graded to the palette by
    // the logic, at the file's own pixels and cut to cover each monitor. It
    // drifts with the camera (parallax), and slides with the shell's drawer.
    permissions { run: "sh", "ls", "test", "magick", "lutgen", "rm", "tee", "cat" }
    text wall.a = ""
    text wall.b = ""
    // A path the shell asks for (`text wall.req ...`, then `emit wall_set`).
    text wall.req = ""
    fact wall.pick = 0
    prop wall.mix = 0 ~1600ms
    follow wall.mix = wall.pick
    event wall_next ->
    event wall_set ->
    image wall.ia = from wall.a, 0, 0
    image wall.ib = from wall.b, 0, 0
    shader tilt = file "tilt.wgsl"
    // The drawer's push, a quarter of its room, on the windows' spring, so the
    // wallpaper leans with it rather than sliding by its width. One spring per
    // monitor: a spring followed from every monitor's copy is one value they
    // fight over.
    repeat s in 0..4 {
        prop wv.p.$s = 0 ~niri
        follow wv.p.$s = win.reserved.$s.left - win.reserved.$s.right + room.$s * 0.25
    }
    // The parallax, one spring per monitor toward where the camera is going,
    // on the windows' spring so the two move as one. While the overview is in
    // or on its way, the spring is kept where the camera goes, unseen: what is
    // shown then is that place, faded by the zoom (below).
    // A tiled window that closes fades out before the rest close the gap:
    // they, the camera and the parallax hold where they are until the fade
    // is done (its 250ms spring).
    fact clh = false
    fact clt = 0
    on still clt for 250ms while clh { clh = false }
    repeat s in 0..4 {
        prop wd.x.$s = 0 ~niri
        prop wd.y.$s = 0 ~niri
        on change cam.tx.$s while not clh { wd.x.$s: -cam.tx.$s * para }
        on change cam.ty.$s while not clh { wd.y.$s: -cam.ty.$s * para }
        on change clh while not clh {
            wd.x.$s: -cam.tx.$s * para
            wd.y.$s: -cam.ty.$s * para
        }
        on change cam.tx.$s while ovp.$s > 0.001 { wd.x.$s: -cam.tx.$s * para ~0ms }
        on change cam.ty.$s while ovp.$s > 0.001 { wd.y.$s: -cam.ty.$s * para ~0ms }
        on change ovp.$s while ovp.$s > 0.001 {
            wd.x.$s: -cam.tx.$s * para ~0ms
            wd.y.$s: -cam.ty.$s * para ~0ms
        }
    }
    // Bigger than the monitor by what the parallax may reach, and in the
    // overview the whole picture, pulled back with the windows on their spring.
    // The parallax eases into its reach instead of stopping at it, so a long
    // pan never halts it mid-motion; the zoom then fades it out toward the
    // middle in step with itself, from where the camera is going, so opening
    // and closing go straight between the two whichever window came before.
    let wv.z = 1.2 - 0.2 * ovp
    let wv.w = Wm * wv.z
    let wv.h = Hm * wv.z
    let wv.mx = (wv.w - Wm) / 2
    let wv.my = (wv.h - Hm) / 2
    let wv.nx = Wm * 0.1
    let wv.ny = Hm * 0.1
    let wv.dx = if(ovp > 0.001, -cam.tx[me] * para, wd.x[me]) + wv.p[me]
    let wv.dy = if(ovp > 0.001, -cam.ty[me] * para, wd.y[me])
    let wv.ox = wv.dx / sqrt(1 + (wv.dx / wv.nx) * (wv.dx / wv.nx)) * (1 - ovp) - wv.mx
    let wv.oy = wv.dy / sqrt(1 + (wv.dy / wv.ny) * (wv.dy / wv.ny)) * (1 - ovp) - wv.my
    // Tilt-shift: a sharp ellipse; values: its half height, the fall-off past
    // it, the full blur, its half width (of the picture), and its centre's
    // shift. The focus runs ahead of the parallax, further than the picture
    // moves, so it reads as depth.
    let tilt.lead = 1.5
    group {
        shader: tilt, 0.15, 0.3, 10, 0.25, tilt.lead * (wv.ox + wv.mx) / wv.w, tilt.lead * (wv.oy + wv.my) / wv.h
        image wall.ia { at: wv.ox, wv.oy; size: wv.w, wv.h; fit: cover; opacity: 1 - wall.mix }
        image wall.ib { at: wv.ox, wv.oy; size: wv.w, wv.h; fit: cover; opacity: wall.mix }
    }

    // what the shell is told: the workspace of each monitor, which monitor
    // has the keyboard, whether the overview is open
    repeat s in 0..4 { text monname.$s = "" }
    event ws_report ->
    event focus_report ->
    event ov_report ->
    repeat s in 0..4 {
        let code.$s = s + 4 * (win.shown.$s + 16 * (win.pools.$s + 16 * min(m.count.$s, 1)))
        on change code.$s { emit ws_report(code.$s) }
        on shell_hello { emit ws_report(code.$s) }
    }
    on change kmon { emit focus_report(kmon) }
    // each monitor's size, which the shell's named surfaces cannot read per
    // monitor: s + 4 * the width, and s + 4 * the height (event values are
    // 32-bit floats, so the two are not packed into one)
    event width_report ->
    event height_report ->
    repeat s in 0..4 {
        let wcode.$s = s + 4 * floor(W.$s + 0.5)
        let hcode.$s = s + 4 * floor(H.$s + 0.5)
        on change wcode.$s { emit width_report(wcode.$s) }
        on change hcode.$s { emit height_report(hcode.$s) }
        on shell_hello {
            emit width_report(wcode.$s)
            emit height_report(hcode.$s)
        }
    }
    // the monitor the pointer is on, plus 4 while a window is being dragged
    event ptr_report ->
    let ptr.code = mon + 4 * if(dmode > 0.5, 1, 0)
    on change ptr.code { emit ptr_report(ptr.code) }
    // each monitor's overview: s + 4 while open
    repeat s in 0..4 {
        on change ov.$s { emit ov_report(s + 4 * if(ov.$s, 1, 0)) }
        on shell_hello { emit ov_report(s + 4 * if(ov.$s, 1, 0)) }
    }
    event shell_hello
    on shell_hello {
        emit focus_report(kmon)
        emit ptr_report(ptr.code)
    }

    zone box desk { from: 0, 0; size: Wm, Hm }
    on enter desk { mon = screen.index }
    // Where each monitor's copy sits in the scene, learnt while the pointer
    // rests on it: during a drag pointer.y is measured from the copy the
    // press was on, so it is corrected by the difference.
    repeat s in 0..4 {
        on hover desk for 200ms while screen.index == s { org.$s = cursor.y - pointer.y }
    }
    on press desk while ov { ov.$screen = false }
    // Super and a drag on empty desk pans the camera, until the keyboard
    // moves it again.
    on press desk while keys.super > 0.5 and not ov {
        dmode = 2
        dslot = -1
        g.x = ofs.x[me]
        g.y = ofs.y[me]
    }
    repeat s in 0..4 {
        on drag desk while dmode == 2 and dslot < 0 and me == s {
            ofs.x.$s = g.x - drag.dx
            ofs.y.$s = g.y - drag.dy
        }
    }
    on release desk { dmode = 0 }
    // With Super, the wheel goes through the windows in order: along the
    // row, then on to the next. One step per notch, with the cooldown so a
    // flick does not race.
    on scroll desk while keys.super > 0.5 and not ov and wcool < 0.5 and wheel < 0 and f.on and f.next >= 0 {
        wcool = 1
        pan = 1
        focus win(f.next)
    }
    on scroll desk while keys.super > 0.5 and not ov and wcool < 0.5 and wheel > 0 and f.on and f.prev >= 0 {
        wcool = 1
        pan = 1
        focus win(f.prev)
    }

    // The tiled window a carried one is over, on its monitor and workspace,
    // and which part of it: -1 its left quarter, 1 its right, 0 the middle.
    let dg = max(dslot, 0)
    let drop.at = -1
    repeat j in 0..win.max {
        drop.at = if(j != dslot and win[j].place >= 0 and win[j].screen == win[dg].screen and win[j].pool == win[dg].pool and pointer.x >= x.$j and pointer.x < x.$j + w.$j and pointer.y >= y.$j and pointer.y < y.$j + h.$j, j, drop.at)
    }
    let da = max(drop.at, 0)
    let drop.side = if(pointer.x < x[da] + w[da] * 0.25, -1, if(pointer.x >= x[da] + w[da] * 0.75, 1, 0))

    // how the top window under the pointer stacks (hz: each one's, or -1)
    prop hztop = -1 ~0ms
    repeat i in 0..win.max { prop hz.$i = -1 ~0ms }

    group {
        // the windows
        repeat i in 0..win.max {
            let sc = win.$i.screen
            let Ws = W[sc]
            let Hs = H[sc]
            let Axs = Ax[sc]
            let AxT = Axs + rmt[sc] - room[sc]
            let Was = Wa[sc]
            let Ays = Ay[sc]
            let Has = Ha[sc]
            let avs = avail[sc]
            let zsc = max(zm[sc], 0.01)
            let camx = vx[sc] / zsc
            let camy = vy[sc] / zsc
            // the camera settled where it is going
            let still = abs(camx - cam.tx[sc]) < 2 and abs(camy - cam.ty[sc]) < 2

            let tiled = win.$i.place >= 0
            // Where its row puts it, with the camera's pan taken off. The pan
            // is dropped in the overview.
            let ovt = ov[sc]
            let pn.x = if(tiled and not win.$i.fullscreen and not ovt, cam.tx[sc], 0)
            let pn.y = if(tiled and not win.$i.fullscreen and not ovt, cam.ty[sc], 0)
            // on whole pixels, so the program's buffer is not resampled
            let tx = round(AxT + gap + avs / 2 + lx.$i - pn.x)
            let ty = round(Ays + Has / 2 + ly.$i - pn.y)
            // The overview's zoom where it is going: around the middle of what
            // the drawer leaves, centred on the monitor. Taken from where
            // everything ends, never from the springs on their way, so each
            // window's one spring goes straight to where it is seen.
            let zw = if(ovt, zt[sc], 1)
            let mt.x = AxT + gap + avs / 2
            let mt.y = Ays + Has / 2
            let mv.x = if(ovt, (Ws + rmt[sc]) / 2 - mt.x, 0)
            // Floating: where it was put; a dialog in the middle at its own size.
            fact fx.$i = 0
            fact fy.$i = 0
            fact fw.$i = 0
            fact fh.$i = 0
            let flo = win.$i.floating or win.$i.dialog
            let dw = max(win.$i.width, 120)
            let dh = max(win.$i.height, 80)
            // Once moved or stretched (fw set), a dialog keeps where it was put
            // too; a window rule's float is one.
            let fgw = if(fw.$i >= 1, max(fw.$i, 200), if(win.$i.dialog, dw, 200))
            let fgh = if(fw.$i >= 1, max(fh.$i, 120), if(win.$i.dialog, dh + tbar * win.$i.framed, 120))
            let fgx = if(fw.$i < 1, AxT + (Was - fgw) / 2, fx.$i)
            let fgy = if(fw.$i < 1, (Hs - fgh) / 2, fy.$i)
            let full = win.$i.fullscreen
            // A tiled window being carried leaves its place and follows the mouse.
            let lifted = dmode == 1 and dslot == i and tiled
            // where the pointer's monitor sits from this window's, for a
            // carried window: it is kept in its own monitor's coordinates
            let dmx = mx[mon] - mx[sc]
            let dmy = my[mon] - my[sc]
            // Maximized. Tiled, it stays in its row: the whole width and the
            // row the whole height, however it got there; its title bar's
            // button sets that, or two thirds of each again. Floating, the
            // whole working area, over the tiles, from that button (big).
            fact big.$i = false
            let mxd = big.$i and flo and not lifted
            let maxed = if(tiled, wp.$i > 0.99 and r.hp.$i > 0.99, big.$i)
            let goal.w = if(full, Ws, if(mxd, avs, if(flo, fgw, tw.$i)))
            let goal.h = if(full, Hs, if(mxd, Has, if(flo, fgh, th.$i)))
            // where it is held, unzoomed, at the size it has now
            let gox = g.fx * goal.w
            let goy = if(g.bar > 0.5, g.oy, g.fy * goal.h)
            let goal.x = if(full, 0, if(mxd, AxT + gap, if(flo, fgx, if(lifted, g.px + dmx - gox, tx))))
            let goal.y = if(full, 0, if(mxd, Ays, if(flo, fgy, if(lifted, g.py + dmy - goy, ty))))
            // ...and where that is seen, zoomed: what its springs go to.
            // Carried, it is under the pointer by where it was held, at the zoom.
            let carried = dmode == 1 and dslot == i and not full
            let sg.x = if(carried, g.px + dmx - gox * zw, mt.x + mv.x + zw * (goal.x - mt.x))
            let sg.y = if(carried, g.py + dmy - goy * zw, mt.y + zw * (goal.y - mt.y))
            let sg.w = zw * goal.w
            let sg.h = zw * goal.h

            // Closed, it stays where it was (below).
            fact last.x.$i = 0
            fact last.y.$i = 0
            fact last.w.$i = 0
            fact last.h.$i = 0
            // Held while one closes (clh): where it was then.
            fact hd.$i = false
            fact hx.$i = 0
            fact hy.$i = 0
            fact hw.$i = 0
            fact hh.$i = 0
            let frz = clh and hd.$i and not carried
            follow x.$i = if(win.$i.open, if(frz, hx.$i, sg.x), last.x.$i)
            follow y.$i = if(win.$i.open, if(frz, hy.$i, sg.y), last.y.$i)
            follow w.$i = if(win.$i.open, if(frz, hw.$i, sg.w), last.w.$i)
            follow h.$i = if(win.$i.open, if(frz, hh.$i, sg.h), last.h.$i)

            // Sent to another monitor by the keyboard: its springs are put where
            // it is now in that monitor's coordinates,
            // so it travels there across the boundary instead of appearing.
            fact psc.$i = 0
            fact xing.$i = 0
            // The keyboard goes with it.
            on change win.$i.screen while ksend == i and win.$i.open {
                x.$i: x.$i + mx[psc.$i] - mx[sc] ~0ms
                y.$i: y.$i + my[psc.$i] - my[sc] ~0ms
                xing.$i = 1
                kmon = sc
                focus win.$i
            }
            on change win.$i.screen while ksend != i { psc.$i = win.$i.screen }
            on change win.$i.open while win.$i.open { psc.$i = win.$i.screen }
            // Landed: drawn on its own monitor alone again.
            let landed = abs(x.$i - sg.x) < 1 and abs(y.$i - sg.y) < 1 and abs(w.$i - sg.w) < 1
            // (what it came from is kept until then: the jump above is worked
            // out after the rule's other changes)
            on change landed while landed and xing.$i > 0.5 and ksend == i { focus win.$i }
            on change landed while landed and xing.$i > 0.5 {
                xing.$i = 0
                psc.$i = win.$i.screen
                ksend = if(ksend == i, -1, ksend)
            }
            on still xing.$i for 1500ms while xing.$i > 0.5 {
                xing.$i = 0
                psc.$i = win.$i.screen
                ksend = if(ksend == i, -1, ksend)
            }
            // A window that opens fades in where it goes; one that closes fades
            // out where it was. No growing or shrinking.
            prop seen.$i = 0 ~250ms
            // Held back until it has its place (place_new) and the rest have
            // moved around it (nrev), then faded in there.
            let waits = nw == i or nrev == i or rtn
            follow seen.$i = if(win.$i.open and not waits, 1, 0)
            // Until it has faded in, it is where it goes at once, so it shows
            // without moving while the rest make room and the camera pans: the
            // last of that lands a frame or two after it starts to show.
            on change sg.x while win.$i.open and seen.$i < 0.99 { x.$i: sg.x ~0ms }
            on change sg.y while win.$i.open and seen.$i < 0.99 { y.$i: sg.y ~0ms }
            on change sg.w while win.$i.open and seen.$i < 0.99 { w.$i: sg.w ~0ms }
            on change sg.h while win.$i.open and seen.$i < 0.99 { h.$i: sg.h ~0ms }
            // Back from the phone: hidden at once, where it settles (above).
            on change phone while phone < 0 and win.$i.open {
                seen.$i: 0 ~0ms
                x.$i: sg.x ~0ms
                y.$i: sg.y ~0ms
                w.$i: sg.w ~0ms
                h.$i: sg.h ~0ms
            }
            // The camera on the one with the keyboard, on whichever monitor it lands.
            on change sc while rtn and win.$i.focused and tiled {
                cam.a[sc] = i
                ofs.x[sc] = 0
                ofs.y[sc] = 0
            }
            // the window that had the keyboard before this one
            let obk = if(lf == i, lf.prev, lf)
            let ob = max(obk, 0)
            on change win.$i.open while win.$i.open {
                x.$i: sg.x ~0ms
                y.$i: sg.y ~0ms
                w.$i: sg.w ~0ms
                h.$i: sg.h ~0ms
                seen.$i: 0 ~0ms
                hd.$i = false
                stamp.$i = stamp.top + 1
                stamp.top = stamp.top + 1
                // At the end of the row of the window that had the keyboard
                // before it, until it is placed (place_new): it may have the
                // keyboard already, and it is out of the rows while it waits.
                rpos.$i = if(win[ob].place >= 0 and obk >= 0, rpos[ob], 1000)
                cpos.$i = 1000 + i
                wp.$i = 0.5
                hp.$i = if(win[ob].place >= 0 and obk >= 0, r.hp[ob], 0.5)
                // On the monitor with the keyboard, as niri does: pleamar-wm puts it
                // where the pointer was last seen over the scene, which a
                // pointer over another window leaves stale.
                send win(i) to kmon
                nw = if(win.$i.dialog or win.$i.floating, nw, i)
                nwt = nwt + 1
            }
            // A closed slot leaves the rows (place -1), drops the camera's pan
            // and a float's size, so where it goes moves the moment it closes:
            // its springs stop where they are instead, still, for the fade.
            on change win.$i.open while not win.$i.open {
                last.x.$i = x.$i
                last.y.$i = y.$i
                last.w.$i = w.$i
                last.h.$i = h.$i
                x.$i: x.$i ~0ms
                y.$i: y.$i ~0ms
                w.$i: w.$i ~0ms
                h.$i: h.$i ~0ms
            }
            on change win.$i.open while not win.$i.open and win.$i.place >= 0 and seen.$i > 0.5 {
                clh = true
                clt = clt + 1
            }
            on change win.$i.focused while win.$i.focused {
                stamp.$i = stamp.top + 1
                stamp.top = stamp.top + 1
            }
            // Floated by the toggle: 800 by 500, in the middle of its monitor.
            on toggle_float while win.focus == i and not win.$i.floating {
                fw.$i = 800
                fh.$i = 500
                fx.$i = Axs + (Was - 800) / 2
                fy.$i = (Hs - 500) / 2
            }
            // Floated by a window rule: in the middle at the size it asked for.
            on change win.$i.floating while win.$i.floating and fw.$i < 1 {
                fw.$i = max(win.$i.width, 800)
                fh.$i = max(win.$i.height, 500)
                fx.$i = Axs + (Was - max(win.$i.width, 800)) / 2
                fy.$i = (Hs - max(win.$i.height, 500)) / 2
            }
            on change win.$i.open while not win.$i.open { fw.$i = 0 }

            // The camera goes to the window the keyboard moved to, and drops
            // any pan by hand.
            on change win.$i.focused while win.$i.focused and tiled and (pan > 0.5 or newpan > 0.5) and nw != i and not cl.pending {
                cam.a[sc] = i
                ofs.x[sc] = 0
                ofs.y[sc] = 0
            }
            // A new window once it has its place: before that it waits out of
            // the rows, and the camera would swing there and back. The camera
            // still holds while the shape is made around it (cam.k), and moves
            // with the rest when it shows.
            on place_new while nw == i and win.$i.focused {
                cam.a[sc] = i
                ofs.x[sc] = 0
                ofs.y[sc] = 0
            }

            let here = sc == me and win.$i.pool == win.pool[sc]
            let lit = win.$i.focused
            image ico.$i = from win.$i.icon, 32, 32
            prop litp.$i = 0 ~160ms
            follow litp.$i = if(lit, 1, 0)
            prop liftp.$i = 0 ~160ms
            follow liftp.$i = if(lifted, 1, 0)
            prop dropp.$i = 0 ~120ms
            follow dropp.$i = if(dmode == 1 and dropj == i and dside == 0, 1, 0)
            prop insp.$i = 0 ~120ms
            follow insp.$i = if(dmode == 1 and dropj == i and dside != 0, 1, 0)
            prop agp.$i = 0 ~400ms
            follow agp.$i = if(ag.live and ag.win == i and win.$i.open, 1, 0)
            let x = x.$i
            let y = y.$i
            let w = w.$i
            let h = h.$i
            // what it is drawn at next to its size: the overview's zoom. Only
            // read with an overview about, so a window growing on its springs
            // keeps its title bar.
            let zc = if(ovp[sc] > 0.001, clamp(w.$i / max(goal.w, 1), 0.05, 1), 1)
            let r = if(full, 0, radius * max(zc, 0.2))
            // its title bar, zoomed with it; the title over it at the view's own
            // size, its band growing over the program in the overview to fit it.
            // None for a program that draws its own.
            let bar = if(full or not win.$i.framed, 0, tbar)
            let bh = bar * zc
            let tov = ovp[sc]
            let th = bh + (30 - bh) * tov * (1 - full)
            // its buttons: on a title bar big enough to read, the overview's too
            let btns = win.$i.open and not full and th > 13
            // Carried, or crossing to another monitor, it is drawn on every
            // monitor, shifted by where each sits from its own, so it shows
            // across the boundary. Lifted, it shrinks around where it is held,
            // which stays under the pointer. Its buttons go with it.
            let wshow = if((dmode == 1 and dslot == i) or xing.$i > 0.5, true, here) and seen.$i > 0.005
            let wmx = if((dmode == 1 and dslot == i) or xing.$i > 0.5, mx[sc] - mx[me], 0)
            let wmy = if((dmode == 1 and dslot == i) or xing.$i > 0.5, my[sc] - my[me], 0)
            let wpx = x + w * if(g.last == i, g.fx, 0.5)
            let wpy = y + if(g.last == i, if(g.bar > 0.5, min(g.oy * zw, h), g.fy * h), h / 2)
            // how it stacks, its handles with it
            // A closed one fading out goes under the rest.
            let wz = if(not win.$i.open, -1, if(full, 100000, if(win.$i.dialog, 60000, if(lifted or xing.$i > 0.5, 90000, if(mxd, 50000, if(win.$i.floating, 1000 + stamp.$i, 0))))))
            // how it stacks while the pointer is over it, title bar included,
            // to tell the top one
            fact under.$i = false
            fact onbar.$i = false
            follow hz.$i = if((under.$i or onbar.$i) and wshow, wz, -1)
            group {
                z: wz
                show: wshow
                move: wmx, wmy
                opacity: seen.$i
                pivot: wpx, wpy
                scale: 1 - 0.05 * liftp.$i
                // Blur what shows through a translucent window, and a soft
                // shadow cut out around it; not under one that asks for glass
                // of its own, which would frost this again.
                body {
                    color: base
                    glass: 80%
                    refraction: 0
                    dispersion: 0
                    dome: 70% + 30% * max(ovp, liftp.$i)
                    ripple: 0
                    frost: 100%
                    tint: 0
                    vivid: 140%
                    smoke: 40%
                    milk: 20%
                    mirror: 0
                    highlight: 0
                    shadow: 0, 4, 48, 16% * (1 - full), crust
                    // show: not win.$i.glass
                    box { from: x, y; size: w, h; corner: r }
                }
                group {
                    clip box { from: x, y; size: w, h; corner: r }
                    // Growing, at the size it is asked for (zoomed), cut by the box
                    // as that travels; shrinking, at the box. Drawn at the box
                    // alone, a program that has not yet answered a resize is
                    // scaled by box over ask; at the size asked alone, one that
                    // has leaves the box's far side bare. Closed, its last image
                    // fades at the box.
                    let atbox = (win.$i.dialog and fw.$i < 1) or not win.$i.open
                    window win.$i { at: x, y + bh; size: if(atbox, w, max(w, goal.w * zc)), if(atbox, h - bh, max(h - bh, (goal.h - bar) * zc)); ask: if(win.$i.dialog and fw.$i < 1, 0, goal.w), if(win.$i.dialog and fw.$i < 1, 0, goal.h - bar) }
                    box { from: x, y; size: w, th; color: crust; opacity: 0.88 * (1 - full) }
                    // its program's icon, scaled with the title bar
                    let isz = clamp(th - 10, 0, 16)
                    image ico.$i { at: x + 10, y + (th - isz) / 2; size: isz, isz; opacity: (1 - full) * if(bh > 13 or tov > 0.5, 1, tov * 2) * mix(0.7, 1, litp.$i) }
                    text win.$i.title { at: x + 16 + isz, y + th / 2; anchor: left center; size: 12; color: mix(subtext0, text, litp.$i); family: "Berkeley Mono"; width: w - 26 - isz - btns * 44; lines: 1; opacity: (1 - full) * if(bh > 13 or tov > 0.5, 1, tov * 2) }
                }
                box { from: x, y; size: w, h; corner: r; stroke: 1; color: mix(base, text, litp.$i); opacity: 1 - full }
                // where a carried window would land: this one, marked
                box { from: x, y; size: w, h; corner: r; color: blue; opacity: 16% * dropp.$i }
                box { from: x, y; size: w, h; corner: r; stroke: 2; color: blue; opacity: dropp.$i }
                // ...or beside it: a bar in the gap it would go into
                box { from: if(dside < 0, x - gap * w / max(goal.w, 1) / 2, x + w + gap * w / max(goal.w, 1) / 2) - 2, y; size: 4, h; corner: 2; color: blue; opacity: insp.$i }
                // an agent at work on it: outlined in its cursor's blue, with a soft glow
                group {
                    show: agp.$i > 0.01
                    opacity: agp.$i
                    group {
                        blur: 8
                        box { from: x - 2, y - 2; size: w + 4, h + 4; corner: r + 2; stroke: 4; color: blue; opacity: 60% }
                    }
                    box { from: x, y; size: w, h; corner: r; stroke: 1.6; color: blue }
                }
            }

            // The keyboard follows the pointer, without moving the camera, and
            // only once the camera and the window have settled, so windows
            // sliding under a still pointer do not take it. Entered mid-slide,
            // it takes it on the next move instead. Of windows overlapping
            // under it, title bars included, only the one on top.
            let hoverok = not win.$i.focused and dmode < 0.5 and not ov and still and abs(x.$i - sg.x) < 2 and abs(y.$i - sg.y) < 2
            // (covered zones see the pointer too)
            on leave win.$i { under.$i = false }
            on enter win.$i { under.$i = true }
            on leave grab.$i { onbar.$i = false }
            on enter grab.$i { onbar.$i = true }
            on change cursor.x while hoverok and hz.$i >= 0 and hz.$i == hztop {
                mon = screen.index
                focus win.$i
            }
            on change cursor.y while hoverok and hz.$i >= 0 and hz.$i == hztop {
                mon = screen.index
                focus win.$i
            }
            // A click is meant: it takes the keyboard even mid-slide, and the
            // camera goes to the window as it does for one picked by key. The
            // click still reaches the program, and the camera only moves once
            // the button is up: a window sliding under a held button is a drag.
            on press win.$i while dmode < 0.5 and not ov and keys.super < 0.5 and not win.$i.focused {
                mon = screen.index
                focus win.$i
            }
            on release win.$i while dmode < 0.5 and not ov and keys.super < 0.5 and tiled and not full {
                cam.a[sc] = i
                ofs.x[sc] = 0
                ofs.y[sc] = 0
            }
            // In the overview a window is picked with a click (pickw, with its
            // handles below), and the camera goes to it even if it already had
            // the keyboard.
            // Hovered in the overview, it is selected: the keyboard goes to it.
            on enter pickw.$i while ov and ovarm and not win.$i.focused and dmode < 0.5 { focus win.$i }
            // and the one already under it, the moment the mouse first moves
            on change ovarm while ovarm and ov and pickw.$i.hover > 0.5 and not win.$i.focused and dmode < 0.5 { focus win.$i }
            on press pickw.$i {
                focus win.$i
                ov.$screen = false
            }
            on press pickw.$i while tiled {
                cam.a[sc] = i
                ofs.x[sc] = 0
                ofs.y[sc] = 0
            }
            // Super let go in a held overview: the selected window is picked
            // as a click would, its workspace shown and the camera on it.
            on still keys.super for 30ms while keys.super < 0.5 and win.$i.focused and ovh[sc] and dmode < 0.5 {
                workspace win.$i.workspace on sc
                cam.a[sc] = i
                ofs.x[sc] = 0
                ofs.y[sc] = 0
            }

            // Its edges and corners stretch it: bands across its border, half
            // in the gap, half over the program. A tiled window's sides set its
            // width, its top and bottom its row's height. Only the left
            // button: pleamar reports no drag or release for the others.
            let edge = 16
            let ex0 = x - edge / 2
            let ey0 = y - edge / 2
            let ex1 = x + w - edge / 2
            let ey1 = y + h - edge / 2
            // With Super held they give way: the whole window carries it.
            // Held while a drag of it lasts, wherever the pointer went.
            let handle = ((keys.super > 0.5 and here) or (dmode == 1 and dslot == i)) and win.$i.open and not full
            let sizing = ((keys.super < 0.5 and here and not ovt) or (dmode == 3 and dslot == i)) and win.$i.open and not full
            // Without Super, its title bar alone carries it.
            let bargrab = keys.super < 0.5 and here and win.$i.open and not full and not ovt
            // A program that draws its own title bar or edges asks for them here.
            let held = win.$i.held > 0.5 and win.$i.open and not full
            // In a group of the window's own z, so the handles of one on top
            // take the press, not those of a tiled one under it.
            group {
                z: wz
                // the overview's pick under the handles: with Super held, a press carries
                zone box pickw.$i { from: x, y; size: w, h; cursor: pointer; active: ov and here and win.$i.open }
                zone box grab.$i { from: x, y; size: w, if(handle or held, h, bh); cursor: if(dmode == 1 and dslot == i, grabbing, grab); active: handle or bargrab or held; handle: i }
                // the edges, then the corners over them: left, right, top,
                // bottom, top left, top right, bottom left, bottom right
                zone box rsz.0.$i { from: ex0, ey0; size: edge, h + edge; cursor: ew_resize; active: sizing or held; handle: i, left }
                zone box rsz.1.$i { from: ex1, ey0; size: edge, h + edge; cursor: ew_resize; active: sizing or held; handle: i, right }
                zone box rsz.2.$i { from: ex0, ey0; size: w + edge, edge; cursor: ns_resize; active: sizing or held; handle: i, top }
                zone box rsz.3.$i { from: ex0, ey1; size: w + edge, edge; cursor: ns_resize; active: sizing or held; handle: i, bottom }
                zone box rsz.4.$i { from: ex0, ey0; size: edge, edge; cursor: nwse_resize; active: sizing or held; handle: i, top_left }
                zone box rsz.5.$i { from: ex1, ey0; size: edge, edge; cursor: nesw_resize; active: sizing or held; handle: i, top_right }
                zone box rsz.6.$i { from: ex0, ey1; size: edge, edge; cursor: nesw_resize; active: sizing or held; handle: i, bottom_left }
                zone box rsz.7.$i { from: ex1, ey1; size: edge, edge; cursor: nwse_resize; active: sizing or held; handle: i, bottom_right }
                zone box wmax.$i { at: x + w - 40, y + th / 2; size: 20, th; cursor: pointer; label: "Maximize"; active: btns and here and dmode < 0.5 and not win.$i.dialog }
                zone box wclose.$i { at: x + w - 18, y + th / 2; size: 20, th; cursor: pointer; label: "Close"; active: btns and here and dmode < 0.5 }
                // maximize (restore once maximized) and close, at the title
                // bar's right end, moving and shrinking with the window
                let bs = clamp(th - 8, 0, 20)
                let bi = clamp(th - 14, 0, 16)
                group {
                    show: btns and wshow
                    move: wmx, wmy
                    opacity: seen.$i * mix(0.6, 1, max(litp.$i, max(wmax.$i.hover, wclose.$i.hover)))
                    pivot: wpx, wpy
                    scale: 1 - 0.05 * liftp.$i
                    group {
                        show: not win.$i.dialog
                        box { at: x + w - 40, y + th / 2; size: bs, bs; corner: bs / 2; color: surface1; opacity: wmax.$i.hover }
                        image btn.max { at: x + w - 40 - bi / 2, y + (th - bi) / 2; size: bi, bi; tint: text; opacity: if(maxed, 0, 1) }
                        image btn.restore { at: x + w - 40 - bi / 2, y + (th - bi) / 2; size: bi, bi; tint: text; opacity: if(maxed, 1, 0) }
                    }
                    box { at: x + w - 18, y + th / 2; size: bs, bs; corner: bs / 2; color: red; opacity: wclose.$i.hover }
                    image btn.close { at: x + w - 18 - bi / 2, y + (th - bi) / 2; size: bi, bi; tint: text }
                }
            }
            // Maximized, or back to the size it had before: a floating one keeps
            // its own, a tiled one its width and its row's height, saved here.
            fact pw.$i = 0.6667
            fact ph.$i = 0.6667
            on maxi(v) while v == i {
                focus win.$i
                pan = 1
            }
            on maxi(v) while v == i and flo { toggle big.$i }
            // (decided in the guards, which read the frame as it began: the
            // sizes change as these run)
            on maxi(v) while v == i and tiled and not maxed {
                pw.$i = if(wp.$i > 0.99 and r.hp.$i > 0.99, 0.6667, wp.$i)
                ph.$i = if(wp.$i > 0.99 and r.hp.$i > 0.99, 0.6667, r.hp.$i)
                wp.$i = 1
                repeat j in 0..win.max {
                    hp.$j = if(win.$j.place >= 0 and win.$j.screen == sc and win.$j.pool == win.$i.pool and rpos.$j == rpos.$i, 1, hp.$j)
                }
            }
            on maxi(v) while v == i and tiled and maxed {
                wp.$i = pw.$i
                repeat j in 0..win.max {
                    hp.$j = if(win.$j.place >= 0 and win.$j.screen == sc and win.$j.pool == win.$i.pool and rpos.$j == rpos.$i, ph.$i, hp.$j)
                }
            }
            on maxi(v) while v == i and tiled { auto[sc] = false }
            on press wmax.$i { emit maxi(i) }
            // Its own maximize button, as that one.
            on window_maximize(v) while v == i and here { emit maxi(i) }
            // Super+f: maximized, then fullscreen, then back to its size.
            on cycle_max while win.focus == i and not full and not maxed { emit maxi(i) }
            on cycle_max while win.focus == i and not full and maxed { fullscreen win.$i }
            on cycle_max while win.focus == i and full { fullscreen win.$i }
            on cycle_max while win.focus == i and full and maxed { emit maxi(i) }
            // Its own minimize button floats it, 800 by 500 in the middle, and back.
            on window_minimize(v) while v == i and here and not win.$i.floating {
                fw.$i = 800
                fh.$i = 500
                fx.$i = Axs + (Was - 800) / 2
                fy.$i = (Hs - 500) / 2
                float win.$i
            }
            on window_minimize(v) while v == i and here and win.$i.floating { tile win.$i }
            on press wclose.$i { close win(i) }
            on change win.$i.open while not win.$i.open { big.$i = false }
            // Carried by its title bar, or anywhere with Super held: the edge
            // bands are on top and take their own presses.
            on press grab.$i {
                focus win.$i
                dslot = i
                dmode = 1
                g.hs = sc
                // where it is held, unzoomed: grabbed in the overview too
                g.oy = (pointer.y - y) / max(h.$i / max(goal.h, 1), 0.05)
                g.fx = clamp((pointer.x - x) / max(w.$i, 1), 0, 1)
                g.fy = clamp((pointer.y - y) / max(h.$i, 1), 0, 1)
                g.bar = if(pointer.y < y + bh, 1, 0)
                g.last = i
                g.px = pointer.x
                g.py = pointer.y
                dropj = -1
            }
            // The pointer is told in the coordinates of the monitor it is on,
            // so the window is held by where it was grabbed, drawn on the
            // monitor the pointer is over, and given to it when let go.
            // A maximized floating window carried away is put back to its own size.
            on drag grab.$i while dmode == 1 and dslot == i and big.$i and flo { big.$i = false }
            // The monitor is the one whose copy holds the pointer, not mon:
            // the desk's enter lands after this, and the first move onto
            // another monitor was read against the one it left.
            repeat s in 0..4 {
                on drag grab.$i while dmode == 1 and dslot == i and s < screens.count and (pointer.y + org[g.hs] - org.$s) >= 0 and (pointer.y + org[g.hs] - org.$s) < H.$s {
                    mon = s
                    g.px = pointer.x
                    g.py = pointer.y + org[g.hs] - org.$s
                }
                on drag grab.$i while dmode == 1 and dslot == i and flo and s < screens.count and (pointer.y + org[g.hs] - org.$s) >= 0 and (pointer.y + org[g.hs] - org.$s) < H.$s {
                    // (where it is seen, taken back out of the zoom)
                    fx.$i = mt.x + (pointer.x + mx[s] - mx[sc] - gox * zw - mt.x - mv.x) / zw
                    fy.$i = mt.y + (pointer.y + org[g.hs] - org.$s + my[s] - my[sc] - goy * zw - mt.y) / zw
                    fw.$i = fgw
                    fh.$i = fgh
                }
            }
            // Carried over another tiled window: that one is marked, and on
            // letting go the two trade places, row heights with them. Over its outer
            // quarters, it goes in beside it instead.
            on drag grab.$i while dmode == 1 and dslot == i and tiled {
                dropj = if(mon == sc, drop.at, -1)
                dside = if(mon == sc and drop.at >= 0, drop.side, 0)
            }
            on release grab.$i while dmode == 1 and dslot == i and tiled and dropj >= 0 and dside == 0 {
                t.c = cpos.$i
                t.r = rpos.$i
                t.h = hp.$i
                cpos.$i = cpos[dropj]
                rpos.$i = rpos[dropj]
                hp.$i = hp[dropj]
                cpos[dropj] = t.c
                rpos[dropj] = t.r
                hp[dropj] = t.h
            }
            // Let go beside it: into its row before or after it, at that row's
            // height, its place made whole again with the rest (norm), and the
            // monitor's rows its own from then, as a move makes them.
            on release grab.$i while dmode == 1 and dslot == i and tiled and dropj >= 0 and dside != 0 {
                rpos.$i = rpos[dropj]
                cpos.$i = cpos[dropj] + dside * 0.01
                hp.$i = r.hp[dropj]
                norm = norm + 1
                auto[sc] = false
            }
            // Let go on another monitor: it goes there, its place turned into
            // that monitor's coordinates at once, so it does not glide across.
            on release grab.$i while dmode == 1 and dslot == i and mon != sc {
                fx.$i = fx.$i - dmx
                fy.$i = fy.$i - dmy
                // (from this monitor's coordinates to that one's)
                x.$i: x.$i - dmx ~0ms
                y.$i: y.$i - dmy ~0ms
                send win(i) to mon
            }
            on release grab.$i while dslot == i {
                dmode = 0
                dslot = -1
                dropj = -1
                dside = 0
            }

            // Stretched by an edge or a corner: g.ex, g.ey say which sides
            // move (-1 the left or top, 1 the right or bottom), the others
            // stay put. Only while the pointer is on its monitor: off it, the
            // pointer is told in another monitor's coordinates (its y off by
            // where that copy sits), and the size holds until it comes back.
            // The y is checked too, since the move that crosses arrives before
            // the monitor under the pointer changes.
            let rs.ok = dmode == 3 and dslot == i and mon == sc and pointer.y >= 0 and pointer.y <= Hs
            repeat e in 0..8 {
                on press rsz.$e.$i {
                    focus win.$i
                    dslot = i
                    dmode = 3
                    g.z = zw
                    g.ex = pick(e, -1, 1, 0, 0, -1, 1, -1, 1)
                    g.ey = pick(e, 0, 0, -1, 1, -1, -1, 1, 1)
                    g.x = fgx
                    g.y = fgy
                    g.w = if(flo, fgw, wp.$i)
                    g.h = if(flo, fgh, r.hp.$i)
                    g.kx = if(rw.$i <= av.$i + 0.5, 2, 1)
                    g.ky = if(tht.$i <= ha.$i + 0.5, 2, 1)
                }
                on drag rsz.$e.$i while rs.ok and flo {
                    fw.$i = if(g.ex == 0, g.w, max(g.w + g.ex * (drag.dx / g.z), 200))
                    fh.$i = if(g.ey == 0, g.h, max(g.h + g.ey * (drag.dy / g.z), 120))
                    fx.$i = if(g.ex < 0, g.x + g.w - fw.$i, g.x)
                    fy.$i = if(g.ey < 0, g.y + g.h - fh.$i, g.y)
                }
                on drag rsz.$e.$i while rs.ok and tiled {
                    rsw = if(g.ex == 0, g.w, clamp(g.w + g.ex * (drag.dx / g.z) * g.kx / uw.$i, 0.1, 1))
                    rsh = if(g.ey == 0, g.h, clamp(g.h + g.ey * (drag.dy / g.z) * g.ky / uh.$i, 0.15, 1))
                }
                on release rsz.$e.$i {
                    dmode = 0
                    dslot = -1
                }
            }
            // A tiled window's width follows its sides while they are dragged.
            on change rsw while dmode == 3 and dslot == i and tiled { wp.$i = rsw }
        }
    }
    let hzm = -1
    repeat i in 0..win.max { hzm = max(hzm, hz.$i) }
    follow hztop = hzm

    // actions, bound in keys.conf
    event close
    event fullscreen
    event cycle_max
    // a window to maximize, or put back, by its slot
    event maxi
    event toggle_float
    // A program's own minimize and maximize buttons, with its slot.
    event window_minimize
    event window_maximize
    event focus_left
    event focus_right
    event focus_up
    event focus_down
    event move_left
    event move_right
    event move_up
    event move_down
    event cycle_width
    event cycle_height
    // Each monitor by its index: the keyboard to the window that had it there
    // last (or to the monitor, if it shows none), or the focused window sent
    // there.
    event focus_monitor
    event move_monitor
    repeat s in 0..4 {
        on focus_monitor(v) while v == s and s < screens.count and m.topslot.$s >= 0 {
            pan = 1
            focus win(m.topslot.$s)
        }
        on focus_monitor(v) while v == s and s < screens.count and m.topslot.$s < 0 {
            kmon = s
            focus win(-1)
        }
        on move_monitor(v) while v == s and s < screens.count and win.focus >= 0 and f.sc != s {
            sendir = if(s > f.sc, 1, -1)
            ksend = win.focus
            send win(win.focus) to s
        }
    }
    on close while win.focus >= 0 { close win(win.focus) }
    on fullscreen while win.focus >= 0 { fullscreen win(win.focus) }
    on toggle_float while win.focus >= 0 and not f.on and win[f].floating > 0.5 { tile win(win.focus) }
    on toggle_float while win.focus >= 0 and f.on { float win(win.focus) }
    // From the shell's rail: monitor + 4 * workspace.
    event workspace_on
    on workspace_on(c) { workspace floor(c / 4) on mod(c, 4) }

    // The phone's monitor (`pleamar-wm remote` from a phone; -1, none): the
    // compositor carries every window there in its own workspace, behind an
    // empty one. It shows the one with the keyboard instead, whichever of the
    // two the compositor says first.
    fact phone = -1
    let ph.f = phone >= 0 and f.live and f.sc == phone
    // Android keeps Super for itself: the Super bindings on Alt there.
    include "../gen/phone-keys.plm"
    on change phone while ph.f { workspace win[f].workspace on phone }
    on change f.sc while ph.f { workspace win[f].workspace on phone }
    // Back from the phone, the windows wait unseen (rtn) while the programs
    // draw at their desk sizes, and fade in where they settled.
    fact rtn = false
    on change phone while phone < 0 { rtn = true }
    on still phone for 300ms while rtn { rtn = false }
    on still nwt for 80ms while nw >= 0 { emit place_new }
    on change clt {
        repeat j in 0..win.max {
            hd.$j = win.$j.open
            hx.$j = x.$j
            hy.$j = y.$j
            hw.$j = w.$j
            hh.$j = h.$j
        }
    }

    // An agent's cursors (`agent on` in session.conf): pleamar-wm says where
    // each is, on which monitor, and when it presses; they are drawn here, on
    // a surface of their own over everything, the programs' menus too, and
    // clicks go through. A ring where it clicks, and its name beside it. They
    // stay while the agent is at work and fade after.
    // Its picture: the user's cursor, every frame, tinted blue
    // (gen/agent-cursor.plm, from the cursor theme), on a clock in ms the logic
    // keeps while an agent is at work (a `spin` here runs once per monitor).
    fact agc.clock = 0
    include "../gen/agent-cursor.plm"
    text agent.name = "agent"
    fact agent.active = 0
    fact agent.win = -1
    fact agent.screen = -1
    fact agent.seen = 0
    // pleamar-wm says agent.active only when it changes, so a scene reloaded
    // while an agent works would not know: a cursor seen lately counts too.
    fact ag.recent = false
    let ag.live = agent.active or ag.recent
    // The window it last worked on, outlined in the windows' loop; an action
    // on a monitor rather than a window (agent.win -1) leaves it.
    fact ag.win = -1
    on change agent.win while agent.win >= 0 { ag.win = agent.win }
    repeat k in 0..2 {
        fact agent.$k.x = 0
        fact agent.$k.y = 0
        fact agent.$k.screen = 0
        fact agent.$k.down = 0
        fact agent.$k.seen = 0
        on change agent.$k.seen { ag.recent = true }
    }
    on still agent.0.seen for 90000ms while ag.recent and not agent.active { ag.recent = false }
    surface agent_hands {
        size: full, full
        anchor: top_left
        level: overlay
        screens: each max 4
        open: ag.live
        repeat k in 0..2 {
            // pleamar-wm moves it along the way, as a hand would: this only
            // smooths the steps.
            prop ag.$k.x = 0 ~140ms
            prop ag.$k.y = 0 ~140ms
            prop ag.$k.on = 0 ~220ms
            prop ag.$k.press = 0 ~90ms
            prop ag.$k.ring = 1 ~560ms
            follow ag.$k.x = agent.$k.x
            follow ag.$k.y = agent.$k.y
            follow ag.$k.press = agent.$k.down
            // Seen again, or on another monitor: there at once, not flying in.
            on change agent.$k.seen while ag.$k.on < 0.05 {
                ag.$k.x: agent.$k.x ~0ms
                ag.$k.y: agent.$k.y ~0ms
            }
            on change agent.$k.screen {
                ag.$k.x: agent.$k.x ~0ms
                ag.$k.y: agent.$k.y ~0ms
            }
            on change agent.$k.seen { ag.$k.on: 1 }
            on change ag.live while not ag.live { ag.$k.on: 0 ~900ms }
            on change agent.$k.down while agent.$k.down > 0.5 {
                ag.$k.ring: 0 ~0ms
                ag.$k.ring: 1 after 16ms
            }
            let ax = ag.$k.x
            let ay = ag.$k.y
            measure tag.$k
            group {
                show: ag.$k.on > 0.01 and agent.$k.screen == screen.index
                opacity: ag.$k.on
                ellipse { at: ax, ay; radius: 4 + 22 * ag.$k.ring; stroke: 2.2 * (1 - ag.$k.ring) + 0.4; color: if(k == 0, teal, lavender); opacity: 80% * (1 - ag.$k.ring) }
                group {
                    pivot: ax, ay
                    scale: 1 - 0.12 * ag.$k.press, 1 - 0.12 * ag.$k.press
                    // the user's own cursor, tinted blue, its tip on the point
                    image agc.sheet { at: ax - agc.hx, ay - agc.hy; size: agc.cell, agc.cell; cell: agc.frame, agc.cols, agc.rows }
                }
                // Its name underneath, centred on the hand.
                let tx = ax - agc.hx + agc.cell / 2
                let ty = ay - agc.hy + agc.cell + 2
                box { from: tx - tag.$k.width / 2 - 8, ty; size: tag.$k.width + 16, 18; corner: 9; color: crust; opacity: 85% }
                text agent.name { at: tx, ty + 9.5; anchor: center; size: 10; weight: 600; color: mix(#ffffff, blue, 0.4); family: "Berkeley Mono"; measure: tag.$k }
            }
        }
    }
}
