+    #[test]
+    fn tilt_follows_motion_and_settles() {
+        let mut physics = CursorPhysics::default();
+        let mut time = Duration::ZERO;
+        let mut pos = Point::from((0., 0.));
+        physics.update(time, pos);
+        for _ in 0..30 {
+            time += Duration::from_millis(16);
+            pos.x += 20.;
+            physics.update(time, pos);
+        }
+        assert!(physics.angle() > 5.);
+        for _ in 0..200 {
+            time += Duration::from_millis(16);
+            physics.update(time, pos);
+        }
+        assert!(!physics.is_active());
+        assert_eq!(physics.angle(), 0.);
+        time += Duration::from_millis(16);
+        physics.update(time, pos + Point::from((-5000., 0.)));
+        assert!(!physics.is_active());
+    }
+
+    #[test]
+    fn warp_glides_to_pointer() {
+        let mut physics = CursorPhysics::default();
+        let mut time = Duration::ZERO;
+        let (from, to) = (Point::from((0., 0.)), Point::from((1000., 0.)));
+        physics.update(time, from);
+        physics.warp(from, to);
+        assert_eq!(physics.offset(), Point::from((-1000., 0.)));
+        let mut last = from.x;
+        let mut speed = 0.;
+        for i in 0..20 {
+            time += Duration::from_millis(16);
+            physics.update(time, to);
+            let drawn = (to + physics.offset()).x;
+            assert!(drawn > last && drawn <= to.x);
+            // Eases in rather than starting at full speed.
+            if i < 3 {
+                assert!(drawn - last > speed);
+            }
+            speed = drawn - last;
+            last = drawn;
+        }
+        assert!(physics.angle() > 0.);
+        for _ in 0..100 {
+            time += Duration::from_millis(16);
+            physics.update(time, to);
+        }
+        assert!(!physics.is_active());
+        assert_eq!(physics.offset(), Point::from((0., 0.)));
+    }
+
+    #[test]
+    fn rotation_keeps_hotspot_and_pixels() {
+        let mut frame = CursorManager::fallback_cursor().images.remove(0);
+        frame.xhot = 3;
+        frame.yhot = 5;
+        let (pixels, (w, h), hotspot) = rotate_frame(&frame, 0.);
+        assert_eq!((w, h), (frame.width as i32, frame.height as i32));
+        assert_eq!(hotspot, Point::from((3., 5.)));
+        assert_eq!(pixels, frame.pixels_rgba);
+        let (pixels, (w, h), _) = rotate_frame(&frame, 20f64.to_radians());
+        assert!(w > frame.width as i32 && h > frame.height as i32);
+        assert_eq!(pixels.len(), (w * h * 4) as usize);
+    }
