+/// Rotates the premultiplied `frame` clockwise by `angle` radians around its hotspot.
+///
+/// Returns the pixels, the size of the tight bounding canvas and the hotspot within it.
+fn rotate_frame(frame: &Image, angle: f64) -> (Vec<u8>, (i32, i32), Point<f64, Physical>) {
+    let (w, h) = (frame.width as i32, frame.height as i32);
+    let (hx, hy) = (frame.xhot as f64, frame.yhot as f64);
+    let (sin, cos) = angle.sin_cos();
+
+    // Bounding box of the rotated frame relative to the hotspot.
+    let (mut min_x, mut min_y, mut max_x, mut max_y) = (0f64, 0f64, 0f64, 0f64);
+    for (x, y) in [(0., 0.), (w as f64, 0.), (0., h as f64), (w as f64, h as f64)] {
+        let (x, y) = (x - hx, y - hy);
+        let (rx, ry) = (x * cos - y * sin, x * sin + y * cos);
+        min_x = min_x.min(rx);
+        min_y = min_y.min(ry);
+        max_x = max_x.max(rx);
+        max_y = max_y.max(ry);
+    }
+    // Snap away from tiny float errors so an unrotated frame keeps its size.
+    let (min_x, min_y) = ((min_x + 1e-9).floor() as i32, (min_y + 1e-9).floor() as i32);
+    let (out_w, out_h) = (
+        (max_x - 1e-9).ceil() as i32 - min_x,
+        (max_y - 1e-9).ceil() as i32 - min_y,
+    );
+
+    let src = &frame.pixels_rgba;
+    let texel = |x: i32, y: i32| -> [f64; 4] {
+        if x < 0 || y < 0 || x >= w || y >= h {
+            return [0.; 4];
+        }
+        let i = ((y * w + x) * 4) as usize;
+        [
+            src[i] as f64,
+            src[i + 1] as f64,
+            src[i + 2] as f64,
+            src[i + 3] as f64,
+        ]
+    };
+
+    let mut out = vec![0u8; (out_w * out_h * 4) as usize];
+    for oy in 0..out_h {
+        for ox in 0..out_w {
+            // Inverse rotation of the output pixel center back into the source frame.
+            let (x, y) = ((ox + min_x) as f64 + 0.5, (oy + min_y) as f64 + 0.5);
+            let sx = x * cos + y * sin + hx - 0.5;
+            let sy = -x * sin + y * cos + hy - 0.5;
+            let (x0, y0) = (sx.floor(), sy.floor());
+            let (fx, fy) = (sx - x0, sy - y0);
+            let (x0, y0) = (x0 as i32, y0 as i32);
+            let (a, b, c, d) = (
+                texel(x0, y0),
+                texel(x0 + 1, y0),
+                texel(x0, y0 + 1),
+                texel(x0 + 1, y0 + 1),
+            );
+            let i = ((oy * out_w + ox) * 4) as usize;
+            for ch in 0..4 {
+                let top = a[ch] + (b[ch] - a[ch]) * fx;
+                let bottom = c[ch] + (d[ch] - c[ch]) * fx;
+                out[i + ch] = (top + (bottom - top) * fy).round() as u8;
+            }
+        }
+    }
+
+    (out, (out_w, out_h), (-min_x as f64, -min_y as f64).into())
+}
+
+/// Angle quantization of rotated cursor frames, in degrees.
+const TILT_STEP_DEG: f64 = 0.25;
+/// Largest tilt, in degrees.
+const TILT_MAX_DEG: f64 = 22.;
+/// Horizontal speed, in logical px/s, at which the tilt reaches ~76% of the maximum.
+const TILT_SPEED: f64 = 1600.;
+/// Time constant of the pointer velocity smoothing, in seconds.
+const TILT_VELOCITY_TAU: f64 = 0.04;
+const TILT_STIFFNESS: f64 = 260.;
+const TILT_DAMPING: f64 = 30.;
+/// Pointer jumps longer than this, in logical px, outside of warps are not motion.
+const TILT_WARP_DISTANCE: f64 = 400.;
+/// Time constant of the lead the glide chases after a pointer warp, in seconds. Chasing a
+/// lead rather than the pointer ramps the pull up from zero, easing in as well as out.
+const GLIDE_LEAD_TAU: f64 = 0.06;
+/// Angular frequency of the critically damped glide spring, in rad/s.
+const GLIDE_OMEGA: f64 = 26.;
+
+/// Cursor motion effects: a spring driven tilt following the horizontal velocity, like an object
+/// dragged by its tip, and a glide across programmatic pointer warps.
+#[derive(Default)]
+pub struct CursorPhysics {
+    /// Last update time, pointer position and drawn position.
+    last: Option<(Duration, Point<f64, Logical>, Point<f64, Logical>)>,
+    /// Pointer displacement from warps since the last update.
+    warped: Point<f64, Logical>,
+    velocity: f64,
+    angle: f64,
+    angular_velocity: f64,
+    /// Drawn position relative to the pointer.
+    offset: Point<f64, Logical>,
+    /// Position relative to the pointer that the drawn position springs toward.
+    lead: Point<f64, Logical>,
+    offset_velocity: Point<f64, Logical>,
+}
+
+impl CursorPhysics {
+    /// Keeps the cursor drawn where it is while the pointer warps from `from` to `to`.
+    pub fn warp(&mut self, from: Point<f64, Logical>, to: Point<f64, Logical>) {
+        self.offset += from - to;
+        self.lead += from - to;
+        self.warped += to - from;
+    }
+
+    /// Advances the simulation to `time` with the pointer at `pos`.
+    pub fn update(&mut self, time: Duration, pos: Point<f64, Logical>) {
+        let Some((last_time, last_pos, last_drawn)) = self.last else {
+            self.last = Some((time, pos, pos + self.offset));
+            self.warped = Point::default();
+            return;
+        };
+        let Some(dt) = time
+            .checked_sub(last_time)
+            .map(|dt| dt.as_secs_f64())
+            .filter(|dt| *dt > 0.)
+        else {
+            return;
+        };
+        // Semi-implicit Euler in small substeps; a long idle gap only needs to settle.
+        let steps = || {
+            let mut remaining = dt.min(0.25);
+            std::iter::from_fn(move || {
+                let step = remaining.min(0.004);
+                remaining -= step;
+                (step > 0.).then_some(step)
+            })
+        };
+
+        for step in steps() {
+            self.lead = self.lead.upscale((-step / GLIDE_LEAD_TAU).exp());
+            let accel = (self.lead - self.offset).upscale(GLIDE_OMEGA * GLIDE_OMEGA)
+                - self.offset_velocity.upscale(2. * GLIDE_OMEGA);
+            self.offset_velocity += accel.upscale(step);
+            self.offset += self.offset_velocity.upscale(step);
+        }
+
+        let drawn = pos + self.offset;
+        self.last = Some((time, pos, drawn));
+        let jump = pos - last_pos - mem::take(&mut self.warped);
+        let dx = if jump.x.hypot(jump.y) > TILT_WARP_DISTANCE {
+            0.
+        } else {
+            (drawn - last_drawn).x
+        };
+        let decay = (-dt / TILT_VELOCITY_TAU).exp();
+        self.velocity = self.velocity * decay + dx / dt * (1. - decay);
+
+        let target = TILT_MAX_DEG * (self.velocity / TILT_SPEED).tanh();
+        for step in steps() {
+            let accel =
+                TILT_STIFFNESS * (target - self.angle) - TILT_DAMPING * self.angular_velocity;
+            self.angular_velocity += accel * step;
+            self.angle += self.angular_velocity * step;
+        }
+
+        if !self.is_active() {
+            *self = Self {
+                last: Some((time, pos, pos)),
+                ..Self::default()
+            };
+        }
+    }
+
+    /// Current clockwise tilt in degrees.
+    pub fn angle(&self) -> f64 {
+        self.angle
+    }
+
+    /// Drawn cursor position relative to the pointer.
+    pub fn offset(&self) -> Point<f64, Logical> {
+        self.offset
+    }
+
+    pub fn is_active(&self) -> bool {
+        self.velocity.abs() > 1.
+            || self.angle.abs() > TILT_STEP_DEG / 2.
+            || self.angular_velocity.abs() > 1.
+            || self.offset.x.hypot(self.offset.y) > 0.1
+            || self.lead.x.hypot(self.lead.y) > 0.1
+            || self.offset_velocity.x.hypot(self.offset_velocity.y) > 1.
+    }
+}
