+    /// View offset relative to column `idx` that centers all columns as a group.
+    fn compute_group_centered_view_offset(&self, idx: usize) -> f64 {
+        let last = self.columns.len() - 1;
+        let first_x = self.column_x(0);
+        let total = self.column_x(last) + self.columns[last].width() - first_x;
+        let area = self.working_area;
+        let view_pos = first_x - (area.size.w - total) / 2. - area.loc.x;
+        view_pos - self.column_x(idx)
+    }
+
+    /// With always-center-single-column, columns that all fit on screen together are centered
+    /// as a group, generalizing the single column case.
+    fn compute_new_view_offset_for_fitting_columns(&self, idx: usize) -> Option<f64> {
+        if !self.options.layout.always_center_single_column || self.columns.len() < 2 {
+            return None;
+        }
+
+        if self.columns.iter().any(|col| !col.sizing_mode().is_normal()) {
+            return None;
+        }
+
+        let last = self.columns.len() - 1;
+        let total = self.column_x(last) + self.columns[last].width() - self.column_x(0);
+        if total + self.options.layout.gaps * 2. > self.working_area.size.w {
+            return None;
+        }
+
+        Some(self.compute_group_centered_view_offset(idx))
+    }
+
+    /// Whether an interactive resize that began with fitting columns is ongoing. The group stays
+    /// centered for the whole drag, even once it grows past the screen, and the view settles
+    /// normally when the resize ends.
+    fn is_resize_centering_group(&self) -> bool {
+        self.resize_centers_group && self.interactive_resize.is_some()
+    }
